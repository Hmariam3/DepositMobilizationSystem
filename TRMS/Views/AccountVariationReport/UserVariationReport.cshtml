@{
    ViewBag.Title = "Account Variation Report - User Level";
}

<div class="panel panel-default" style="padding:15px;">
    <div class="panel-heading">
        <h3>
            <i class="fa fa-balance-scale text-info"></i>
            <span id="reportTitle">My Account Variation Report</span>
        </h3>
    </div>
    <hr />

    <!-- Filters -->
    <div id="filterSection">
        <form id="filterForm" class="mb-4">
            <div class="row g-3">
                <div class="col-md-3" id="districtFilterContainer" style="display:none;">
                    <label><strong>District</strong></label>
                    <select id="district" class="form-control">
                        <option value="All">All Districts</option>
                        @foreach (var d in ViewBag.Districts)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Refresh</button>
                    <button type="button" id="btnReset" class="btn btn-secondary">Reset</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Summary -->
    <div class="alert alert-info mb-4" role="alert">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <strong>User Performance Summary</strong>
                <span class="badge bg-info ms-2">Balance Movement</span>
            </div>
            <div class="d-flex gap-4 flex-wrap">
                <div>
                    <strong>Total Variation:</strong>
                    <span id="grandTotalVariation" class="fw-bold">Loading...</span>
                </div>
                <div>
                    <strong>Overall % Change:</strong>
                    <span id="grandTotalPercentage" class="badge bg-secondary">Loading...</span>
                </div>
            </div>
        </div>
    </div>

    <!-- DataTable -->
    <div class="table-responsive">
        <table id="variationTable" class="table table-bordered table-hover table-striped" style="width:100%">
            <thead class="table-dark">
                <tr>
                    <th style="width:60px">No</th>
                    <th>Full Name</th>
                    <th># Accounts</th>
                    <th>Branch</th>
                    <th>District</th>
                    <th>Beginning Balance</th>
                    <th>Current Balance</th>
                    <th>Variation</th>
                    <th>% Change</th>
                                </tr>
                            </thead>
            <tbody></tbody>
        </table>
    </div>

    <button id="btnExport" class="btn btn-success mt-3">
        <i class="fa fa-file-excel-o"></i> Export to Excel
    </button>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            var currentUser = {
                role: "@ViewBag.CurrentUserRole",
                position: "@ViewBag.CurrentUserPosition",
                process: "@ViewBag.CurrentUserProcess",
                district: "@ViewBag.CurrentUserDistrict",
                branch: "@ViewBag.CurrentUserBranch",
                userName: "@ViewBag.CurrentUserName",
                fullName: "@ViewBag.CurrentUserFullName",
                reportstatus: "@ViewBag.ReportStatus"
            };

            var filterMode = "";
            var fixedFilter = {};
            const managerPositions = [
                "Branch Manager I", "Branch Manager II", "Branch Manager III", "Branch Manager IV",
                "Senior Manager", "Manager", "Acting Manager"
            ];
            const directorPositions = [
                "Director", "Acting Director", "District Director", "District Senior Director", "Senior Director"
            ];

            if (currentUser.role === "Super") {
                $("#reportTitle").text("Bank-Wide Account Variation Report");
                $("#districtFilterContainer").show();
                filterMode = "bank";
            }
            else if (currentUser.role === "Maker") {
                if (["VP", "CHF"].includes(currentUser.position) && ["True"].includes(currentUser.reportstatus)) {
                    $("#reportTitle").text(`Process: ${currentUser.process} - Account Variation Report`);
                    filterMode = "process";
                    fixedFilter.process = currentUser.process;
                }
                else if (directorPositions.includes(currentUser.position) && ["True"].includes(currentUser.reportstatus)) {
                    $("#reportTitle").text(`District: ${currentUser.district} - Account Variation Report`);
                    filterMode = "subprocess";
                    fixedFilter.district = currentUser.district;
                    $("#districtFilterContainer").show().find("select").val(currentUser.district).prop("disabled", true);
                }
                else if (managerPositions.includes(currentUser.position) && ["True"].includes(currentUser.reportstatus)) {
                    $("#reportTitle").text(`Branch: ${currentUser.branch} - Account Variation Report`);
                    filterMode = "branch";
                    fixedFilter.branch = currentUser.branch;
                }
                else {
                    $("#reportTitle").text(`My Performance - ${currentUser.fullName || currentUser.userName}`);
                    filterMode = "self";
                    fixedFilter.userName = currentUser.userName;
                    $("#filterSection").hide();
                }
            }

            var table = $('#variationTable').DataTable({
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "@Url.Action("UserVariationAjax", "AccountVariationReport")",
                    "type": "POST",
                    "data": function (d) {
                        d.district = $('#district').val() || "All";
                        d.filterMode = filterMode;
                        d.fixedProcess = fixedFilter.process || "";
                        d.fixedDistrict = fixedFilter.district || "";
                        d.fixedBranch = fixedFilter.branch || "";
                        d.fixedUserName = fixedFilter.userName || "";
                    }
                },
                "pageLength": 25,
                "order": [[8, "desc"]], // sort by Variation descending
                "columns": [
                    {
                        "data": null,
                        "orderable": false,
                        "render": function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { "data": "FullName" },
                    {
                        "data": "AccountCount",
                        "className": "text-center fw-bold"
                    },
                    { "data": "Branch" },
                    { "data": "District" },
                    {
                        "data": "Beginning",
                        "render": $.fn.dataTable.render.number(',', '.', 2)
                    },
                    {
                        "data": "Current",
                        "render": $.fn.dataTable.render.number(',', '.', 2)
                    },
                    {
                        "data": "Variation",
                        "render": function (data) {
                            var val = parseFloat(data || 0);
                            var sign = val > 0 ? "+" : "";
                            var cls = val > 0 ? "text-success fw-bold" :
                                      val < 0 ? "text-danger fw-bold" : "text-muted";
                            return `<span class="${cls}">${sign}${val.toLocaleString('en-US', {minimumFractionDigits: 2})}</span>`;
                        }
                    },
                    {
                        "data": "Percentage",
                        "render": function (data) {
                            var val = parseFloat(data || 0);
                            var badge = val > 5 ? 'bg-success' :
                                       val > 0 ? 'bg-info' :
                                       val < -5 ? 'bg-danger' : 'bg-secondary';
                            var sign = val >= 0 ? '+' : '';
                            return `<span class="badge ${badge}">${sign}${val.toFixed(2)}%</span>`;
                        }
                    }
                ],
                "drawCallback": function (settings) {
                    var json = settings.json;
                    if (json) {
                        $('#grandTotalVariation').text(json.grandVariation || '0.00');
                        var pct = parseFloat(json.grandPercentage?.replace(/%/g, '') || '0');
                        var $badge = $('#grandTotalPercentage');
                        var cls = pct > 5 ? 'bg-success' :
                                 pct > 0 ? 'bg-info' :
                                 pct < -5 ? 'bg-danger' : 'bg-secondary';
                        $badge.text(pct.toFixed(2) + '%')
                              .removeClass('bg-success bg-info bg-danger bg-secondary')
                              .addClass(cls);
                    }
                }
            });

            $('#filterForm').on('submit', function (e) {
                e.preventDefault();
                table.ajax.reload();
            });

            $('#btnReset').click(function () {
                $('#district').val('All');
                table.ajax.reload();
            });

            // ----------------------------------------------------------------
            // Export to Excel – Client-Side (SheetJS)
            // ----------------------------------------------------------------
            $('#btnExport').click(function () {
                const $btn = $(this).prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Exporting...');
                const currentLength = table.page.len();
                const currentPage = table.page();

                // 1. Fetch all data
                table.page.len(-1).draw();

                table.one('draw', function () {
                    try {
                        const allData = table.rows().data().toArray();
                        const json = table.settings()[0].json || {};

                        let exportData = [];

                        // 2. Header Information
                        exportData.push(["USER VARIATION REPORT"]);
                        exportData.push([]);
                        exportData.push([`Scope: ${$("#reportTitle").text().trim()}`]);
                        exportData.push([`District: ${$('#district').val() || 'All'}`]);
                        exportData.push([`Generated: ${moment().format('dddd, DD MMMM YYYY [at] HH:mm')}`]);
                        exportData.push([`Total Records: ${allData.length.toLocaleString()}`]);
                        exportData.push([]);

                        // 3. Column Headers
                        exportData.push([
                            "No", "Full Name", "# Accounts", "Branch", "District",
                            "Beginning Balance", "Current Balance", "Variation", "% Change"
                        ]);

                        // 4. Data Rows & Loop Calculation
                        let totalBeginning = 0;
                        let totalCurrent = 0;
                        let totalVariation = 0;

                        allData.forEach((row, i) => {
                            const beg = parseFloat(row.Beginning || 0);
                            const cur = parseFloat(row.Current || 0);
                            const vari = parseFloat(row.Variation || 0);
                            
                            totalBeginning += beg;
                            totalCurrent += cur;
                            totalVariation += vari;

                            exportData.push([
                                i + 1,
                                row.FullName || "N/A",
                                row.AccountCount || 0,
                                row.Branch || "-",
                                row.District || "-",
                                beg,
                                cur,
                                vari,
                                parseFloat(row.Percentage || 0) / 100
                            ]);
                        });

                        // 5. Grand Totals
                        // Calculate percentage from summed totals if possible, else fallback to server json
                        const totalPct = totalBeginning !== 0 ? (totalVariation / totalBeginning) : 0;

                        exportData.push([]);
                        exportData.push([
                            "GRAND TOTAL", "", "",
                            "", "",
                            totalBeginning,
                            totalCurrent,
                            totalVariation,
                            totalPct
                        ]);

                        // 6. Worksheet Creation
                        const wb = XLSX.utils.book_new();
                        const ws = XLSX.utils.aoa_to_sheet(exportData);

                        // 7. Styling (Matching UserAchievementReport)
                        const range = XLSX.utils.decode_range(ws['!ref']);
                        for (let R = 0; R <= range.e.r; ++R) {
                            for (let C = 0; C <= range.e.c; ++C) {
                                const addr = XLSX.utils.encode_cell({ r: R, c: C });
                                if (!ws[addr]) continue;
                                const cell = ws[addr];

                                // Title
                                if (R === 0) {
                                    cell.s = { font: { bold: true, sz: 18, color: { rgb: "1F4E79" } }, alignment: { horizontal: "center" } };
                                }
                                // Info Rows
                                else if (R >= 2 && R <= 5) {
                                    cell.s = { font: { italic: true, color: { rgb: "555555" } } };
                                }
                                // Header Row
                                else if (R === 7) {
                                    cell.s = { font: { bold: true, color: { rgb: "FFFFFF" } }, fill: { fgColor: { rgb: "366092" } }, alignment: { horizontal: "center" } };
                                }
                                    // Data & Total Rows
                                else if (R >= 8) {
                                    const isTotal = R === exportData.length - 1;
                                    cell.s = {
                                        font: { bold: isTotal },
                                        fill: isTotal ? { fgColor: { rgb: "D9E2F3" } } : undefined,
                                        alignment: { 
                                            horizontal: C >= 5 ? "right" : (C === 2 ? "center" : "left"), // Right align numbers, center #Accounts
                                            vertical: "top"
                                        },
                                        border: { top: { style: "thin" }, bottom: { style: isTotal ? "double" : "thin" }, left: { style: "thin" }, right: { style: "thin" } }
                                    };
                                    
                                    // Conditional Formatting for Variation (Col H - index 7) and % Change (Col I - index 8)
                                    if ((C === 7 || C === 8) && !isTotal) { 
                                        const val = parseFloat(cell.v || 0);
                                        const color = val > 0 ? "27AE60" : val < 0 ? "E74C3C" : "555555"; 
                                        cell.s.font = { bold: true, color: { rgb: color } };
                                    }
                                }
                            }
                        }

                        // Col Widths
                        ws['!cols'] = [
                            { wch: 6 }, { wch: 28 }, { wch: 12 },
                            { wch: 20 }, { wch: 20 }, { wch: 18 }, { wch: 18 },
                            { wch: 18 }, { wch: 12 }
                        ];

                        // Merges
                        ws['!merges'] = [
                            { s: { r: 0, c: 0 }, e: { r: 0, c: 8 } }, // Title
                            { s: { r: exportData.length - 1, c: 0 }, e: { r: exportData.length - 1, c: 4 } } // Total Label
                        ];

                        // Number Formats
                        for (let r = 8; r < exportData.length - 1; r++) {
                            // Accounts (Col C) - Integer
                            const ac = ws['C' + (r + 1)]; if (ac) ac.z = "#,##0";

                            ['F', 'G', 'H'].forEach(col => {
                                const c = ws[col + (r + 1)];
                                if (c) c.z = "#,##0.00";
                            });
                            const pc = ws['I' + (r + 1)];
                            if (pc) pc.z = "0.00%";
                        }

                        ['F', 'G', 'H', 'I'].forEach(col => {
                            const c = ws[col + exportData.length];
                            if (c) c.z = col === 'I' ? "0.00%" : "#,##0.00";
                        });

                        XLSX.utils.book_append_sheet(wb, ws, "User Variation");
                        XLSX.writeFile(wb, `User_Variation_${moment().format('YYYYMMDD_HHmm')}.xlsx`);

                        toastr.success(`Exported ${allData.length.toLocaleString()} records!`);
                    } catch (err) {
                        console.error(err);
                        toastr.error("Export failed!");
                    } finally {
                        table.page.len(currentLength).page(currentPage).draw('page');
                        $btn.prop('disabled', false).html('<i class="fa fa-file-excel-o"></i> Export to Excel');
                    }
                });
            });
        });
    </script>
}