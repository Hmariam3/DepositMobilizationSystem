@{
    ViewBag.Title = "Account Variation Report - Branch Level";
}

<div class="panel panel-default" style="padding:15px;">
    <div class="panel-heading">
        <h3>
            <i class="fa fa-building text-primary"></i>
            <span id="reportTitle">Branch Variation Report</span>
        </h3>
    </div>
    <hr />

    <!-- Filters -->
    <div id="filterSection">
        <form id="filterForm" class="mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-4 col-lg-3">
                    <label><strong>District</strong></label>
                    <select id="district" class="form-control">
                        <option value="All">All Districts</option>
                        @foreach (var d in ViewBag.Districts)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>

                <div class="col-md-4 col-lg-3">
                    <label><strong>Branch</strong> <small class="text-muted">(optional search)</small></label>
                    <input type="text" id="branchSearch" class="form-control" placeholder="Filter by branch name..." />
                </div>

                <div class="col-md-4 col-lg-3">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fa fa-refresh"></i> Refresh
                    </button>
                    <button type="button" id="btnReset" class="btn btn-secondary">
                        <i class="fa fa-undo"></i> Reset
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Summary -->
    <div class="alert alert-info mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <strong>Branch Performance Summary</strong>
                <span class="badge bg-info ms-2">Balance Movement</span>
            </div>
            <div class="d-flex gap-4 flex-wrap">
                <strong>Total Variation Across Branches:</strong>
                <span id="grandTotalVariation" class="fw-bold">Loading...</span>
                <strong>Overall % Change:</strong>
                <span id="grandTotalPercentage" class="badge bg-secondary">Loading...</span>
            </div>
        </div>
    </div>

    <!-- DataTable -->
    <div class="table-responsive">
        <table id="branchTable" class="table table-bordered table-hover table-striped" style="width:100%">
            <thead class="table-dark">
                <tr>
                    <th style="width:60px">No</th>
                    <th>Branch</th>
                    <th>District</th>
                    <th># Accounts</th>
                    <th>Beginning Balance</th>
                    <th>Current Balance</th>
                    <th>Variation</th>
                    <th>% Change</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <button id="btnExport" class="btn btn-success mt-3">
        <i class="fa fa-file-excel-o"></i> Export to Excel
    </button>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {

            var currentUser = {
                role: "@ViewBag.CurrentUserRole",
                position: "@ViewBag.CurrentUserPosition",
                process: "@ViewBag.CurrentUserProcess",
                district: "@ViewBag.CurrentUserDistrict",
                branch: "@ViewBag.CurrentUserBranch",
                userName: "@ViewBag.CurrentUserName",
                fullName: "@ViewBag.CurrentUserFullName",
                reportstatus: "@ViewBag.ReportStatus"
            };

            var filterMode = "";
            var fixedFilter = {};
            const managerPositions = [
                "Branch Manager I", "Branch Manager II", "Branch Manager III", "Branch Manager IV",
                "Senior Manager", "Manager", "Acting Manager"
            ];
            const directorPositions = [
                "Director", "Acting Director", "District Director", "District Senior Director", "Senior Director"
            ];

            if (currentUser.role === "Super") {
                $("#reportTitle").text("Bank-Wide Branch Variation Report");
                filterMode = "bank";
            }
            else if (currentUser.role === "Maker") {
                if (["VP", "CHF"].includes(currentUser.position) && ["True"].includes(currentUser.reportstatus)) {
                    $("#reportTitle").text(`Process: ${currentUser.process} - Branch Variation`);
                    filterMode = "process";
                    fixedFilter.process = currentUser.process;
                }
                else if (directorPositions.includes(currentUser.position) && ["True"].includes(currentUser.reportstatus)) {
                    $("#reportTitle").text(`District: ${currentUser.district} - Branch Variation`);
                    filterMode = "subprocess";
                    fixedFilter.district = currentUser.district;
                    $("#district").val(currentUser.district).prop("disabled", true);
                }
                else if (managerPositions.includes(currentUser.position) && ["True"].includes(currentUser.reportstatus)) {
                    $("#reportTitle").text(`Branch: ${currentUser.branch} - Branch Variation`);
                    filterMode = "branch";
                    fixedFilter.branch = currentUser.branch;
                    // For branch managers, we might want to just show their branch
                }
                else {
                    $("#reportTitle").text(`My Branch Performance - ${currentUser.branch}`);
                    filterMode = "branch";
                    fixedFilter.branch = currentUser.branch;
                    $("#filterSection").hide();
                }
            }

            var table = $('#branchTable').DataTable({
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "@Url.Action("BranchVariationAjax", "AccountVariationReport")",
                    "type": "POST",
                    "data": function (d) {
                        d.district = $('#district').val() || "All";
                        d.filterMode = filterMode;
                        d.fixedProcess = fixedFilter.process || "";
                        d.fixedDistrict = fixedFilter.district || "";
                        d.fixedBranch = fixedFilter.branch || "";
                    }
                },
                "pageLength": 20,
                "order": [[5, "desc"]], // sort by Variation descending
                "columns": [
                    {
                        "data": null,
                        "orderable": false,
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { "data": "Branch" },
                    { "data": "District" },
                    { "data": "CountAccounts", className: "text-center" },
                    {
                        "data": "Beginning",
                        render: $.fn.dataTable.render.number(',', '.', 2)
                    },
                    {
                        "data": "Current",
                        render: $.fn.dataTable.render.number(',', '.', 2)
                    },
                    {
                        "data": "Variation",
                        render: function (data) {
                            var val = parseFloat(data);
                            var sign = val >= 0 ? "+" : "";
                            var cls = val > 0 ? "text-success fw-bold" : val < 0 ? "text-danger fw-bold" : "text-muted";
                            return `<span class="${cls}">${sign}${val.toLocaleString('en-US', {minimumFractionDigits: 2})}</span>`;
                        }
                    },
                    {
                        "data": "Percentage",
                        render: function (data) {
                            var val = parseFloat(data);
                            var badge = val > 5 ? 'bg-success' : val > 0 ? 'bg-info' : val < -5 ? 'bg-danger' : 'bg-secondary';
                            var sign = val >= 0 ? '+' : '';
                            return `<span class="badge ${badge}">${sign}${val.toFixed(2)}%</span>`;
                        }
                    }
                ],
                "drawCallback": function (settings) {
                    var json = settings.json;
                    if (json) {
                        let variation = json.grandVariation || '0.00';
                        let pct = parseFloat(json.grandPercentage || '0').toFixed(2);

                        $('#grandTotalVariation').text(variation);

                        let $badge = $('#grandTotalPercentage');
                        let cls = pct > 5 ? 'bg-success' : pct > 0 ? 'bg-info' : pct < -5 ? 'bg-danger' : 'bg-secondary';

                        $badge.text(pct + '%')
                              .removeClass('bg-success bg-info bg-danger bg-secondary')
                              .addClass(cls);
                    }
                }
            });

            // Submit filter
            $('#filterForm').on('submit', function (e) {
                e.preventDefault();
                table.ajax.reload();
            });

            // Reset
            $('#btnReset').click(function () {
                $('#district').val('All');
                $('#branchSearch').val('');
                table.ajax.reload();
            });

            // Optional: live filter on branch name input (client-side)
            $('#branchSearch').on('keyup', function () {
                table.column(1).search(this.value.trim()).draw();
            });

            // ----------------------------------------------------------------
            // Export to Excel – Client-Side (SheetJS)
            // ----------------------------------------------------------------
            $('#btnExport').click(function () {
                const $btn = $(this).prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Exporting...');
                const originalLength = table.page.len();
                
                table.page.len(-1).draw(false); // Fetch all

                table.one('draw', function () {
                    try {
                        const rows = table.rows({ search: 'applied' }).data().toArray();
                        const json = table.settings()[0].json || {};

                        let exportData = [];

                        // Header Info
                        exportData.push(["BRANCH VARIATION REPORT"]);
                        exportData.push([]);
                        exportData.push([`District: ${$('#district').val() || 'All Districts'}`]);
                        exportData.push([`Generated: ${moment().format('dddd, MMMM DD, YYYY [at] HH:mm')}`]);
                        exportData.push([`Total Branches Shown: ${rows.length}`]);
                        exportData.push([]);

                        // Columns
                        exportData.push([
                            "No", "Branch", "District", "Accounts", "Beginning Balance", "Current Balance",
                            "Variation", "% Change"
                        ]);

                        // Data & Totals
                        let totalBeginning = 0;
                        let totalCurrent = 0;
                        let totalVariation = 0;

                        rows.forEach((row, i) => {
                            const beg = parseFloat(row.Beginning || 0);
                            const cur = parseFloat(row.Current || 0);
                            const vari = parseFloat(row.Variation || 0);

                            totalBeginning += beg;
                            totalCurrent += cur;
                            totalVariation += vari;

                            exportData.push([
                                i + 1,
                                row.Branch || '-',
                                row.District || '-',
                                row.CountAccounts || 0,
                                beg,
                                cur,
                                vari,
                                parseFloat(row.Percentage || 0) / 100
                            ]);
                        });

                        // Totals
                        const totalPct = totalBeginning !== 0 ? (totalVariation / totalBeginning) : 0;

                        exportData.push([]);
                        exportData.push([
                            "TOTAL", "",
                            "",
                            "",
                            totalBeginning,
                            totalCurrent,
                            totalVariation,
                            totalPct
                        ]);

                        const wb = XLSX.utils.book_new();
                        const ws = XLSX.utils.aoa_to_sheet(exportData);

                        // Styling
                        const range = XLSX.utils.decode_range(ws['!ref']);
                        for (let R = 0; R <= range.e.r; ++R) {
                            for (let C = 0; C <= range.e.c; ++C) {
                                const addr = XLSX.utils.encode_cell({ r: R, c: C });
                                if (!ws[addr]) continue;
                                const cell = ws[addr];

                                if (R === 0) {
                                    cell.s = { font: { bold: true, sz: 18, color: { rgb: "1F4E79" } }, alignment: { horizontal: "center" } };
                                }
                                else if (R >= 2 && R <= 4) {
                                    cell.s = { font: { italic: true, color: { rgb: "555555" } } };
                                }
                                else if (R === 6) {
                                    cell.s = { font: { bold: true, color: { rgb: "FFFFFF" } }, fill: { fgColor: { rgb: "366092" } }, alignment: { horizontal: "center" } };
                                }
                                else if (R >= 7) {
                                    const isTotal = R === exportData.length - 1;
                                    cell.s = {
                                        font: { bold: isTotal },
                                        fill: isTotal ? { fgColor: { rgb: "D9E2F3" } } : undefined,
                                        alignment: { horizontal: C >= 4 ? "right" : "left" },
                                        border: { top: { style: "thin" }, bottom: { style: isTotal ? "double" : "thin" }, left: { style: "thin" }, right: { style: "thin" } }
                                    };
                                    
                                    if (C === 7 && !isTotal) { // % Change
                                        const val = (cell.v || 0) * 100;
                                        const color = val > 0 ? "27AE60" : val < 0 ? "E74C3C" : "555555";
                                        cell.s.font = { bold: true, color: { rgb: color } };
                                    }
                                }
                            }
                        }

                        ws['!cols'] = [
                            { wch: 6 },  // A: No
                            { wch: 30 }, // B: Branch
                            { wch: 25 }, // C: District (Maximized)
                            { wch: 12 }, // D: Accounts
                            { wch: 18 }, // E: Beginning Balance
                            { wch: 18 }, // F: Current Balance
                            { wch: 18 }, // G: Variation
                            { wch: 12 }  // H: % Change
                        ];
                        
                        ws['!merges'] = [
                            { s: { r: 0, c: 0 }, e: { r: 0, c: 7 } },
                            { s: { r: exportData.length - 1, c: 0 }, e: { r: exportData.length - 1, c: 3 } }
                        ];

                        // Number formats
                        for (let r = 7; r < exportData.length - 1; r++) {
                            // Accounts (Col D) - Integer
                            const ac = ws['D' + (r+1)]; if (ac) ac.z = "#,##0";
                            
                            // Money columns (E, F, G)
                            ['E','F','G'].forEach(col => { 
                                const c = ws[col + (r+1)]; 
                                if (c) c.z = "#,##0.00"; 
                            });
                            
                            // % Change (Col H)
                            const pc = ws['H' + (r+1)]; if (pc) pc.z = "0.00%";
                        }

                        // Totals Row
                        ['E','F','G','H'].forEach(col => {
                            const c = ws[col + exportData.length];
                            if (c) c.z = col === 'H' ? "0.00%" : "#,##0.00";
                        });

                        XLSX.utils.book_append_sheet(wb, ws, "Branch Variation");
                        XLSX.writeFile(wb, `Branch_Variation_${moment().format('YYYYMMDD_HHmm')}.xlsx`);

                        toastr.success("Export completed");
                    } catch (err) {
                        console.error(err);
                        toastr.error("Export failed");
                    } finally {
                        table.page.len(originalLength).draw('page');
                        $btn.prop('disabled', false).html('<i class="fa fa-file-excel-o"></i> Export to Excel');
                    }
                });
            });
        });
    </script>
}