@model IEnumerable<TRMS.Models.Fcy_Branch>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel panel-default" style="padding-left:10px;">
    <div class="panel-heading">
        <h3>Fcy Target</h3>
    </div>
    <hr />
    @if (TempData["errorRes"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["errorRes"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["successRes"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["successRes"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <table id="employeeDT" class="table table-striped">
        <thead>
            <tr>

                <th>
                    @Html.DisplayName("District")
                </th>
                <th>
                    @Html.DisplayName("Branch")
                </th>
                <td>
                    @Html.DisplayName("Target Amount")
                </td>
                
                <th>
                    @Html.DisplayName("Maker")
                </th>
                <th>
                    @Html.DisplayName("Tran Date")
                </th>
                <th>Actions</th>
       
             

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.District)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Branch)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FcyTargetAmount)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedBy)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedDate)
                    </td>
                    <td>
                        @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Are you sure you want to delete this item?');" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script>
        $(document).ready(function () {
            $('#employeeDT').DataTable({
                "paging": true,      // Enable pagination
                "searching": true,   // Enable search box
                "ordering": true,    // Enable sorting
                "lengthMenu": [5, 10, 25, 50], // Page length options
                "pageLength": 5,    // Default rows per page
                "info": true,        // Show table info
                "language": {
                    "search": "Search User:", // Customize search placeholder
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ User"
                }
            });
        });
</script>
