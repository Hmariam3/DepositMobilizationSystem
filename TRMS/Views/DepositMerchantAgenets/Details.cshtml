@model TRMS.Models.DepositMerchantAgenet
@{
    ViewBag.Title = "Merchant Deposit Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    :root {
        --primary: #00AEEF;
        --primary-gradient: linear-gradient(135deg, #00AEEF, #0077b6);
        --success: #198754;
        --danger: #dc3545;
        --gray: #6c757d;
        --light: #f8f9fa;
        --dark: #212529;
        --border-radius: 1rem;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        --merchant: #6f42c1;
    }


    .detail-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .page-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .page-header h1 {
        font-weight: 800;
        font-size: 2.2rem;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: 0.5px;
    }

    .detail-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        overflow: hidden;
        border: 2px solid var(--primary-gradient);
    }

    .card-header {
        background: var(--primary-gradient);
        color: white;
        padding: 1rem 2rem;
        font-weight: 600;
        font-size: 1.3rem;
        text-align: center;
    }

    .card-header i {
        margin-right: 0.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-weight: 600;
        color: var(--dark);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .info-value {
        font-size: 1.1rem;
        color: var(--primary);
        font-weight: 500;
        word-break: break-all;
    }

    .info-value code {
        background: #f3e8ff;
        padding: 0.2rem 0.5rem;
        border-radius: 0.4rem;
        font-family: 'Courier New', monospace;
        color: var(--merchant);
    }

        .info-value .badge {
            background: var(--primary-gradient);
            color: white;
            font-weight: 600;
            padding: 0.35em 0.65em;
            font-size: 0.75rem;
            border-radius: 0.5rem;
        }

    .btn-back {
        background: #6c757d;
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-back:hover {
        background: #5a6268;
        transform: translateY(-2px);
    }

    .btn-back i {
        font-size: 1.1rem;
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
        .card-body {
            padding: 1.5rem;
        }
    }
</style>

<div class="detail-container">

    <!-- Detail Card -->
    <div class="detail-card mt-3">
        <div class="card-header">
            <i class="fas fa-store"></i> Merchant Deposit Record Details
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">District</div>
                    <div class="info-value">@Html.DisplayFor(m => m.District)</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Branch</div>
                    <div class="info-value">@Html.DisplayFor(m => m.Branch)</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Target Amount</div>
                    <div class="info-value text-success fw-bold">@String.Format("{0:N2}", Model.Target)</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Merchant ID</div>
                    <div class="info-value"><span class="badge">@Html.DisplayFor(m => m.LinkAccount)</span></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Account Number</div>
                    <div class="info-value"><code>@Html.DisplayFor(m => m.AccountNumber)</code></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Account Holder</div>
                    <div class="info-value">@Html.DisplayFor(m => m.AccountHolder)</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Account Balance</div>
                    <div class="info-value text-info fw-bold">@String.Format("{0:N2}", Model.AccountBalance)</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Created By</div>
                    <div class="info-value">@Html.DisplayFor(m => m.CreatedBY)</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Created Date</div>
                    <div class="info-value">@Model.CreatedDate.ToString("dd MMM yyyy, HH:mm")</div>
                </div>
            </div>

            <div class="mt-4 text-end">
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn-back" })
            </div>
        </div>
    </div>
</div>