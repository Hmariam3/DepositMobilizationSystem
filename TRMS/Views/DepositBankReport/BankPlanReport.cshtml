@{
    ViewBag.Title = "Bank Deposit Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel panel-default" style="padding:15px;">
    <div class="panel-heading">
        <h3><i class="fa fa-bank"></i> Bank Deposit Report</h3>
    </div>
    <hr />

    <form id="filterForm" class="mb-4">
        <div class="row">
            <div class="col-md-3">
                <label><strong>Start Date:</strong></label>
                <input type="date" id="startDate" name="startDate" class="form-control" />
            </div>
            <div class="col-md-3">
                <label><strong>End Date:</strong></label>
                <input type="date" id="endDate" name="endDate" class="form-control" />
            </div>
            <div class="col-md-3">
                <label><strong>District:</strong></label>
                <select id="district" name="district" class="form-control">
                    <option value="All">All Districts</option>
                    @foreach (var d in ViewBag.District)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="fa fa-filter"></i> Apply Filter
                </button>
                <button type="button" id="btnReset" class="btn btn-secondary">
                    <i class="fa fa-refresh"></i> Reset
                </button>
            </div>
        </div>
    </form>

    <hr />

    <div class="alert alert-info mb-3">
        <i class="fa fa-calculator"></i>
        Total Collected Amount: <strong id="totalAmountDisplay">Loading...</strong>
    </div>

    <div class="table-responsive">
        <table id="transactionDT" class="table table-striped table-bordered table-hover" style="width:100%">
            <thead class="table-dark">
                <tr>
                    <th>Process</th>
                    <th>District</th>
                    <th>Branch</th>
                    <th>Account No</th>
                    <th>Ref No</th>
                    <th>Account Holder</th>
                    <th>Amount</th>
                    <th>Type</th>
                    <th>Narrative</th>
                    <th>User</th>
                    <th>Target</th>
                    <th>Date</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="mt-3">
        <button id="btnExport" class="btn btn-success">
            <i class="fa fa-file-excel-o"></i> Export to Excel
        </button>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#transactionDT').DataTable({
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "@Url.Action("BankPlanReportAjax")",
                    "type": "POST",
                    "data": function (d) {
                        d.startDate = $('#startDate').val();
                        d.endDate = $('#endDate').val();
                        d.district = $('#district').val();
                    }
                },
                "pageLength": 25,
                "lengthMenu": [10, 25, 50, 100, 500],
                "order": [[11, "desc"]],
                "columns": [
                    { "data": "Process" },
                    { "data": "District" },
                    { "data": "Branch" },
                    { "data": "AccountNumber" },
                    { "data": "ReferenceNumber" },
                    { "data": "AccountHolder" },
                    { "data": "Amount", "render": $.fn.dataTable.render.number(',', '.', 2) },
                    { "data": "DepositType" },
                    { "data": "Narative" },
                    { "data": "User" },
                    { "data": "UserDepositTarget", "render": function (data) {
                        return data ? parseFloat(data).toLocaleString('en', { minimumFractionDigits: 2 }) : "0.00";
                    }},
                    { "data": "CreatedDate", "render": function (data) {
                        return new Date(data).toLocaleDateString();
                    }}
                ],
                "drawCallback": function (settings) {
                    if (settings.json && settings.json.totalAmount) {
                        $('#totalAmountDisplay').text(settings.json.totalAmount);
                    }
                }
            });

            // Apply Filter
            $('#filterForm').on('submit', function (e) {
                e.preventDefault();
                table.ajax.reload();
            });

            // Reset
            $('#btnReset').click(function () {
                $('#startDate, #endDate').val('');
                $('#district').val('All');
                table.ajax.reload();
            });

            // Export Button
            $('#btnExport').click(function () {
                var url = "@Url.Action("ExcelBankPlanReport")" +
                    "?startDate=" + encodeURIComponent($('#startDate').val()) +
                    "&endDate=" + encodeURIComponent($('#endDate').val()) +
                    "&district=" + encodeURIComponent($('#district').val());
                window.location.href = url;
            });
        });
    </script>
}