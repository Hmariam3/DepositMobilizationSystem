@model IEnumerable<TRMS.Models.DepositFCY>

@{
    ViewBag.Title = "FCY Report by District";
}

<div class="panel panel-default" style="padding:15px;">
    <div class="panel-heading">
        <h3><i class="fa fa-university"></i> Bank Foreign Currency (FCY) Report</h3>
    </div>

    <hr />

    <form method="get" class="mb-4">
        <div class="row">
            <div class="col-md-3">
                <label><strong>Start Date:</strong></label>
                <input type="date" name="startDate" class="form-control" value="@Request.QueryString["startDate"]" />
            </div>
            <div class="col-md-3">
                <label><strong>End Date:</strong></label>
                <input type="date" name="endDate" class="form-control" value="@Request.QueryString["endDate"]" />
            </div>
            <div class="col-md-3">
                <label><strong>District:</strong></label>
                <select name="district" class="form-control">
                    <option value="All">All</option>
                    @foreach (var district in ViewBag.District)
                    {
                        <option value="@district" @(Request.QueryString["district"] == district ? "selected" : "")>@district</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="fa fa-filter"></i> Filter
                </button>
                <a href="@Url.Action("BankDepositFcy")" class="btn btn-secondary">
                    <i class="fa fa-refresh"></i> Reset
                </a>
            </div>
        </div>
    </form>

    <hr />

    <div class="table-responsive">
        <table id="transactionDT" class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Process</th>
                    <th>District</th>
                    <th>Branch</th>
                    <th>Currency</th>
                    <th>Account Number</th>
                    <th>Reference Number</th>
                    <th>Transaction Amount</th>
                    <th>Deposit Type</th>
                    <th>Narrative</th>
                    <th>User</th>
                    <th>Transaction Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Process</td>
                        <td>@item.District</td>
                        <td>@item.Branch</td>
                        <td>@item.Currecy</td>
                        <td>@item.AccountNumber</td>
                        <td>@item.RefernceNumber</td>
                        <td>@item.TransactionAmount.ToString("N2")</td>
                        <td>@item.DepositType</td>
                        <td>@item.Narative</td>
                        <td>@item.User</td>
                        <td>@item.CreatedDate.ToString("MM/dd/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <h4 class="alert alert-info">
            <i class="fa fa-calculator"></i> Total Transaction Amount:
            <strong>@ViewBag.totalAmount.ToString("N2")</strong>
        </h4>
    </div>

    <a href="@Url.Action("ExportBankDepositFcy", new { startDate = Request.QueryString["startDate"], endDate = Request.QueryString["endDate"], district = Request.QueryString["district"] })"
       class="btn btn-success">
        <i class="fa fa-file-excel-o"></i> Export to Excel
    </a>
</div>

<script>
    $(document).ready(function () {
        $('#transactionDT').DataTable({
            "paging": true,
            "searching": true,
            "ordering": true,
            "info": true,
            "pageLength": 5,
            "lengthMenu": [5, 10, 25, 50, 100],
            "language": {
                "search": "Search Records:",
                "lengthMenu": "Show _MENU_ entries",
                "info": "Showing _START_ to _END_ of _TOTAL_ records"
            }
        });
    });
</script>
