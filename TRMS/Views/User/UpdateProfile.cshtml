@model TRMS.Models.User
@{
    ViewBag.Title = "Edit Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    :root {
        --primary: #00AEEF;
        --primary-dark: #008cc7;
        --primary-gradient: linear-gradient(135deg, #00AEEF, #0077b6);
        --success: #198754;
        --danger: #dc3545;
        --warning: #ffc107;
        --light: #f8f9fa;
        --dark: #212529;
        --gray: #6c757d;
        --border-radius: 1rem;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }



    .edit-container {
        max-width: 1300px;
        margin: 0 auto;
    }

    .page-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .page-header h1 {
        font-weight: 800;
        font-size: 2.2rem;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: 0.5px;
        margin: 0;
    }

    .page-header p {
        color: var(--gray);
        font-size: 1.1rem;
        margin-top: 0.5rem;
    }

    .user-summary-card,
    .form-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .user-summary-card:hover,
    .form-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    }

    .card-header {
        background: var(--primary-gradient);
        color: white;
        padding: 1rem 2rem;
        text-align: center;
        font-weight: 600;
        font-size: 1.3rem;
        letter-spacing: 0.5px;
    }

    .card-header i {
        margin-right: 0.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        border-bottom: 1px dashed #e9ecef;
        font-size: 0.95rem;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: 600;
        color: var(--dark);
    }

    .info-value {
        color: var(--primary);
        font-weight: 500;
    }

    .form-label {
        font-weight: 600;
        color: var(--dark);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    /* === Base styling for both normal inputs and Select2 visible field === */
    .form-control,
    .select2-container--bootstrap-5 .select2-selection--single {
        border-radius: 0.75rem;
        border: 1px solid #ced4da;
        padding: 0.1rem 1rem;
        font-size: 0.95rem;
        height: calc(3rem + 2px); /* consistent height */
        transition: all 0.3s ease;
        background-color: #fff; /* optional: ensure white bg */
    }

        /* Focus / active state - same for both */
        .form-control:focus,
        .select2-container--bootstrap-5 .select2-selection--single:focus-within,
        .select2-container--bootstrap-5.select2-container--focus .select2-selection--single {
            border-color: var(--primary); /* your primary color, e.g. #00AEEF */
            box-shadow: 0 0 0 0.2rem rgba(0, 174, 239, 0.25);
            outline: none;
        }

        /* Make sure the inner text aligns nicely inside Select2 */
        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
            line-height: calc(3.5rem - 2px); /* centers text vertically */
            padding-left: 0; /* remove default left padding if needed */
            padding-right: 2rem; /* space for arrow */
        }

    /* Dropdown results - scrollable when many items */
    .select2-container--bootstrap-5 .select2-results__options {
        max-height: 320px; /* ≈ 9–11 visible items */
        overflow-y: auto;
        overflow-x: hidden;
    }

        /* Optional: nicer scrollbar */
        .select2-container--bootstrap-5 .select2-results__options::-webkit-scrollbar {
            width: 6px;
        }

        .select2-container--bootstrap-5 .select2-results__options::-webkit-scrollbar-thumb {
            background: #adb5bd;
            border-radius: 3px;
        }

            .select2-container--bootstrap-5 .select2-results__options::-webkit-scrollbar-thumb:hover {
                background: #6c757d;
            }

    /* Optional: consistent arrow color / style */
    .select2-container--bootstrap-5 .select2-selection--single .select2-selection__arrow {
        height: calc(3.5rem + 2px);
        top: 0;
    }

    .target-section h5 {
        color: var(--primary);
        font-weight: 700;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary);
        display: inline-block;
    }

    .btn-container {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e9ecef;
    }

    .btn-save {
        background: var(--primary-gradient);
        border: none;
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 174, 239, 0.4);
    }

    .btn-back {
        background: #6c757d;
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: #5a6268;
        transform: translateY(-2px);
    }

    .alert {
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        border: none;
        font-weight: 500;
    }

    .alert-success {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
    }

    .alert-danger {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        color: #721c24;
    }

    @@media (max-width: 992px) {
        .edit-container {
            padding: 1rem;
        }
        .btn-container {
            flex-direction: column;
        }
        .btn-save, .btn-back {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .page-header h1 {
            font-size: 1.8rem;
        }
        .card-body {
            padding: 1.5rem;
        }
    }
</style>

<div class="edit-container">
    <!-- Page Header -->
    <div class="page-header">
        <h1>Update Profile</h1>
        <p>Edit your profile, targets, and organizational details</p>
    </div>

    <!-- Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Error!</strong> @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Success!</strong> @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">
        <!-- Left: AD User Info Summary (Read-only) -->
        <div class="col-lg-5">
            <div class="user-summary-card">
                <div class="card-header">
                    <i class="fas fa-user-circle"></i> Active Directory Info
                </div>
                <div class="card-body">
                    <div class="info-item">
                        <span class="info-label">Username:</span>
                        <span class="info-value">@Model.UserName</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Full Name:</span>
                        <span class="info-value">@Model.FullName</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Email:</span>
                        <span class="info-value">@Model.MailAdress</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Org Unit:</span>
                        <span class="info-value">@Model.OrganizatinalUnit</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Position:</span>
                        <span class="info-value">@Model.Postion</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Editable Form -->
        <div class="col-lg-7">
            <div class="form-card">
                <div class="card-header">
                    <i class="fas fa-edit"></i> Edit Profile & Targets
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("UpdateProfile", "User", FormMethod.Post, new { id = "editUserForm", @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.ID)
                        @Html.HiddenFor(m => m.UserName)
                        @Html.HiddenFor(m => m.FullName)
                        @Html.HiddenFor(m => m.MailAdress)

                        @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

                    <div class="row g-3">
                        <!-- Process -->
                        <div class="col-md-6">
                            <label class="form-label">Process <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.Process, (SelectList)ViewBag.Processes, "Select Process", new { @class = "form-select select2", id = "ProcessDropdown" })
                            @Html.ValidationMessageFor(m => m.Process, "", new { @class = "text-danger small mt-1" })
                        </div>


                        <!-- Subprocess/District -->
                        <div class="col-md-6">
                            <label class="form-label">Subprocess/District <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.District, (SelectList)ViewBag.Subprocesses, "Select Subprocess", new { @class = "form-select select2", id = "SubprocessDropdown" })
                            @Html.ValidationMessageFor(m => m.District, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <!-- Branch -->
                        <div class="col-md-6">
                            <label class="form-label">Team/Branch <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.Branch, (SelectList)ViewBag.Branches, "Select Branch", new { @class = "form-select select2", id = "BranchDropdown" })
                            @Html.ValidationMessageFor(m => m.Branch, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <!-- Organizational Unit -->
                        <div class="col-md-6">
                            <label class="form-label">Organizational Unit <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.OrganizatinalUnit, new List<SelectListItem>
                            {
                                new SelectListItem { Text = "HO", Value = "HO" },
                                new SelectListItem { Text = "District", Value = "District" },
                                new SelectListItem { Text = "Branch", Value = "Branch" }
                            }, "Select Unit", new { @class = "form-select select2" })
                            @Html.ValidationMessageFor(m => m.OrganizatinalUnit, "", new { @class = "text-danger small mt-1" })
                        </div>

                        <!-- Position -->
                        @*<div class="col-md-6">
                            <label class="form-label">Position <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.Postion, new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Individual", Value = "Individual" },
                                new SelectListItem { Text = "BranchManager", Value = "BranchManager" },
                                new SelectListItem { Text = "Manager", Value = "Manager" },
                                new SelectListItem { Text = "SeniorManager", Value = "SeniorManager" },
                                new SelectListItem { Text = "Director", Value = "Director" },
                                new SelectListItem { Text = "SeniorDirector", Value = "SeniorDirector" },
                                new SelectListItem { Text = "VP", Value = "VP" },
                                new SelectListItem { Text = "CHIEF", Value = "CHF" },
                                new SelectListItem { Text = "CEO", Value = "CEO" }
                            }, "Select Position", new { @class = "form-select select2", id = "positionId" })
                            @Html.ValidationMessageFor(m => m.Postion, "", new { @class = "text-danger small mt-1" })
                        </div>*@
                        <!-- Position -->
                        <div class="col-md-6">
                            <label class="form-label">Position <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.Postion, (SelectList)ViewBag.Position, "Select Process", new { @class = "form-select select2", id = "PositionDropdown" })
                            @Html.ValidationMessageFor(m => m.Postion, "", new { @class = "text-danger small mt-1" })
                        </div>
                        <!-- Phone Number -->
                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            @Html.EditorFor(m => m.PhoneNumber, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g. +251911234567" } })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                        <!-- Target Sections -->
                        <div class="row mt-4 g-4">
                            <!-- Individual Targets -->
                            <div class="col-md-6">
                                <div class="target-section">
                                    <h5>Individual Targets</h5>
                                    <div class="mb-3">
                                        @Html.LabelFor(m => m.DepositTargetAmount, new { @class = "form-label" })
                                        @Html.EditorFor(m => m.DepositTargetAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                        @Html.ValidationMessageFor(m => m.DepositTargetAmount, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                    <div class="mb-3">
                                        @Html.LabelFor(m => m.MerchantTarget, new { @class = "form-label" })
                                        @Html.EditorFor(m => m.MerchantTarget, new { htmlAttributes = new { @class = "form-control", @type = "number", @min = "0", placeholder = "0" } })
                                        @Html.ValidationMessageFor(m => m.MerchantTarget, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                    <div class="mb-3" id="fcyTargetContainer">
                                        @Html.LabelFor(m => m.FCYTargetAmount, new { @class = "form-label" })
                                        @Html.EditorFor(m => m.FCYTargetAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                        @Html.ValidationMessageFor(m => m.FCYTargetAmount, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                </div>
                            </div>

                            <!-- Branch Targets -->
                            <div class="col-md-6" id="branchTargetContainer">
                                <div class="target-section">
                                    <h5>Branch Targets</h5>
                                    <div class="mb-3">
                                        @Html.LabelFor(m => m.BranchDepositTarget, new { @class = "form-label" })
                                        @Html.EditorFor(m => m.BranchDepositTarget, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                        @Html.ValidationMessageFor(m => m.BranchDepositTarget, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                    <div class="mb-3">
                                        @Html.LabelFor(m => m.BranchMerchantTarget, new { @class = "form-label" })
                                        @Html.EditorFor(m => m.BranchMerchantTarget, new { htmlAttributes = new { @class = "form-control", placeholder = "0" } })
                                        @Html.ValidationMessageFor(m => m.BranchMerchantTarget, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                    <div class="mb-3">
                                        @Html.LabelFor(m => m.BranchFcyTarget, new { @class = "form-label" })
                                        @Html.EditorFor(m => m.BranchFcyTarget, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                        @Html.ValidationMessageFor(m => m.BranchFcyTarget, "", new { @class = "text-danger small mt-1" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="btn-container">
                            <input type="submit" value="Save Changes" class="btn btn-save" />
                            @Html.ActionLink("Cancel", "Index", "Home", null, new { @class = "btn btn-back" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        // Initialize Select2
        $('.select2').select2({
            theme: 'bootstrap-5',
            width: '100%',
            placeholder: function () {
                return $(this).data('placeholder');
            }
        });

        // Cascading Dropdowns
        $('#ProcessDropdown').change(function () {
            const processName = $(this).val();
            const $subprocess = $('#SubprocessDropdown');
            const $branch = $('#BranchDropdown');

            $subprocess.empty().append('<option value="">Select Subprocess</option>').val('').trigger('change');
            $branch.empty().append('<option value="">Select Branch</option>').val('').trigger('change');

            if (processName) {
                $.get('@Url.Action("GetSubprocesses", "User")', { processName: processName })
                    .done(function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (i, item) {
                                $subprocess.append($('<option>', {
                                    value: item.subprocess_name,
                                    text: item.subprocess_name
                                }));
                            });
                        }
                    });
            }
        });

        $('#SubprocessDropdown').change(function () {
            const subprocessName = $(this).val();
            const $branch = $('#BranchDropdown');
            $branch.empty().append('<option value="">Select Branch</option>').val('').trigger('change');

            if (subprocessName) {
                $.get('@Url.Action("GetBranches", "User")', { subprocessName: subprocessName })
                    .done(function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (i, item) {
                                $branch.append($('<option>', {
                                    value: item.BranchName,
                                    text: item.BranchName
                                }));
                            });
                        }
                    });
            }
        });

        // Toggle Targets based on Position
        function toggleTargets() {
            const position = $('#PositionDropdown').val() || '';  // safe-guard against null/undefined

            const $branchContainer = $('#branchTargetContainer');
            const $fcyContainer = $('#fcyTargetContainer');

            // Define position groups (exact matches – case sensitive!)
            const branchManagerPositions = [
                "Branch Manager I",
                "Branch Manager II",
                "Branch Manager III",
                "Branch Manager IV"
            ];

            const directorPositions = [
                "Director",
                "Acting Director",
                "District Director",
                "District Senior Director",
                "Senior Director",
                "VP",
                "Chief",
                "CEO"
            ];

            // ──────────────────────────────────────────────
            // Branch Targets: ONLY for Branch Managers I–IV
            // ──────────────────────────────────────────────
            if (branchManagerPositions.includes(position)) {
                $branchContainer.slideDown();
            } else {
                $branchContainer.slideUp();
                $branchContainer.find('input').val('');   // optional: clear values when hidden
            }

            // ──────────────────────────────────────────────
            // FCY Target: Branch Managers + Director-level
            // ──────────────────────────────────────────────
            const shouldShowFCY =
                branchManagerPositions.includes(position) ||
                directorPositions.includes(position);

            if (shouldShowFCY) {
                $fcyContainer.slideDown();
            } else {
                $fcyContainer.slideUp();
                $fcyContainer.find('input').val('');     // optional: clear when hidden
            }
 
        }

        // Run once on page load
        $(document).ready(function () {
            toggleTargets();
            $('#PositionDropdown').on('change', toggleTargets);
        });


        // Form Validation
        const form = document.getElementById('editUserForm');
        form.addEventListener('submit', function (e) {
            if (!form.checkValidity()) {
                e.preventDefault();
                e.stopPropagation();
            }
            form.classList.add('was-validated');
        });
    });
</script>