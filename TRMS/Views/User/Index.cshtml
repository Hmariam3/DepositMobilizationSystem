@model IEnumerable<TRMS.Models.User>
@{
    ViewBag.Title = "Users";

}
<div class="panel panel-default" style="padding-left:10px;">
    <div class="panel-heading">
        <h3>User List</h3>
    </div>
    <table id="employeeDT" class="table table-striped">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.UserName)</th>
                <th>@Html.DisplayNameFor(model => model.FullName)</th>
                <th>@Html.DisplayNameFor(model => model.Branch)</th>
                <th>@Html.DisplayNameFor(model => model.Process)</th>
                <th>@Html.DisplayName("sub process")</th>
                <th>@Html.DisplayNameFor(model => model.Postion)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                    <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                    <td>@Html.DisplayFor(modelItem => item.Branch)</td>
                    <td>@Html.DisplayFor(modelItem => item.Process)</td>
                    <td>@Html.DisplayFor(modelItem => item.Branch)</td> <!-- Ensure Department exists in Model -->
                    <td>@Html.DisplayFor(modelItem => item.Postion)</td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <script>
    $(document).ready(function () {
        $('#employeeDT').DataTable({
            "paging": true,      // Enable pagination
            "searching": true,   // Enable search box
            "ordering": true,    // Enable sorting
            "lengthMenu": [5, 10, 25, 50], // Page length options
            "pageLength": 10,    // Default rows per page
            "info": true,        // Show table info
            "language": {
                "search": "Search User:", // Customize search placeholder
                "lengthMenu": "Show _MENU_ entries",
                "info": "Showing _START_ to _END_ of _TOTAL_ User"
            }
        });
    });
    </script>

