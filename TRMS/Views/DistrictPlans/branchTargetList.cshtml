@model IEnumerable<TRMS.Models.BranchTarget>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="panel panel-default" style="padding-left:10px;">
    <div class="panel-heading">
        <h3>Branch Target</h3>
    </div>
    <hr />
    @if (TempData["errorRes"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["errorRes"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["successRes"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["successRes"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <table id="employeeDT" class="table table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayName("District ")
                </th>
                <th>
                    @Html.DisplayName("Branch")
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Deposit)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FCY)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.merchant)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CreatedBy)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CreatedDate)
                </th>
                <th>Actions</th>
           

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.District)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BranchName)
                </td>
                <td>
                    @(item.Deposit.ToString("N2"))
                </td>
                <td>

                    @(item.FCY.ToString("N2"))
                </td>
                <td>

                    @(item.merchant.ToString("N2")) 
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedBy)
                </td>
                <td>
                    @item.CreatedDate.ToString("MM/dd/yyyy")
                </td>
                <td>
                    @Html.ActionLink("Delete", "DeleteBranchtarget", new { id = item.BID }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Are you sure you want to delete this item?');" })
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
<script>
        $(document).ready(function () {
            $('#employeeDT').DataTable({
                "paging": true,      // Enable pagination
                "searching": true,   // Enable search box
                "ordering": true,    // Enable sorting
                "lengthMenu": [5, 10, 25, 50], // Page length options
                "pageLength": 5,    // Default rows per page
                "info": true,        // Show table info
                "language": {
                    "search": "Search User:", // Customize search placeholder
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ User"
                }
            });
        });
</script>