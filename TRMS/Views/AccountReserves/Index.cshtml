@model IEnumerable<TRMS.Models.AccountReserve>

@{
    ViewBag.Title = "Account Reserves";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #00AEEF;
        --primary-dark: #008cc7;
        --primary-gradient: linear-gradient(135deg, #00AEEF, #0077b6);
        --success: #198754;
        --danger: #dc3545;
        --warning: #ffc107;
        --light: #f8f9fa;
        --dark: #212529;
        --gray: #6c757d;
        --border-radius: 1rem;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .index-container {
        width: 100%;
        margin: 0;
        padding: 0 1rem 2rem;
    }

    .toolbar-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        margin-bottom: 1.5rem;
        padding: 1rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .page-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

        .page-header h1 {
            font-weight: 800;
            font-size: 2.2rem;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 0.5px;
            margin: 0;
        }

    .data-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        overflow: hidden;
        transition: all 0.3s ease;
    }

        .data-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
        }

    .card-header {
        background: var(--primary-gradient);
        color: white;
        padding: 0.5rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 600;
        font-size: 1.3rem;
    }

        .card-header .btn-create {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .card-header .btn-create:hover {
                background: white;
                color: var(--primary);
                transform: translateY(-2px);
            }

    .table {
        margin: 0;
        font-size: 0.95rem;
    }

        .table thead {
            background: #f1f3f5;
        }

            .table thead th {
                border: none;
                font-weight: 600;
                color: var(--dark);
                text-transform: uppercase;
                font-size: 0.8rem;
                letter-spacing: 0.5px;
                padding: 1rem;
            }

        .table tbody td {
            padding: 0.9rem 1rem;
            vertical-align: middle;
            border-color: #e9ecef;
        }

        .table tbody tr:hover {
            background: rgba(0, 174, 239, 0.05);
        }

    .btn-action {
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
        border-radius: 0.5rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .btn-edit {
        background: #0d6efd;
        color: white;
    }

        .btn-edit:hover {
            background: #0b5ed7;
        }

    .btn-details {
        background: #0dcaf0;
        color: white;
    }

        .btn-details:hover {
            background: #0aa8c7;
        }

    .btn-delete {
        background: var(--danger);
        color: white;
    }

        .btn-delete:hover {
            background: #c82333;
        }

    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        border-radius: 0.5rem;
        border: 1px solid #ced4da;
        padding: 0.35rem 0.75rem;
        font-size: 0.9rem;
    }
</style>

<div class="index-container">

    <!-- Messages -->
    @if (TempData["errorRes"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Error!</strong> @TempData["errorRes"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["successRes"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Success!</strong> @TempData["successRes"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Toolbar / Export Buttons -->
    @*<div class="toolbar-card mt-3">
        <div>
            <h5 class="mb-1">Export & Tools</h5>
            <small class="text-muted">Quickly export or print account reserve records</small>
        </div>
        <div id="customButtons" class="dt-buttons"></div>
    </div>*@

    <!-- Main Data Card -->
    <div class="data-card  mt-5">
        <div class="card-header">
            <div>
                <i class="fas fa-landmark"></i> Account Reserves
            </div>
            <a href="@Url.Action("Create", "AccountReserves")" class="btn-create">
                <i class="fas fa-plus-circle me-1"></i> New Reserve Account
            </a>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="accountReserveTable" class="table table-striped table-hover" style="width:100%">
                    <thead>
                        <tr>
                            <th>Account Number</th>
                            <th>Account Holder</th>
                            @*<th>Balance</th>*@
                            <th>Username</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><code>@Html.DisplayFor(m => item.AccountNumber)</code></td>
                                <td class="fw-medium">@Html.DisplayFor(m => item.AccountHolder)</td>
                                @*<td class="text-end fw-bold text-success">
                                    @String.Format("{0:N2}", item.AccountBalance)
                                </td>*@
                                <td>@Html.DisplayFor(m => item.UserName)</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        @Html.ActionLink("Details", "Details", new { id = item.ACC_ID }, new { @class = "btn btn-details btn-action" })
                                       @* @Html.ActionLink("Delete", "Delete", new { id = item.ACC_ID }, new { @class = "btn btn-delete btn-action" })*@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#accountReserveTable').DataTable({
                responsive: true,
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                lengthMenu: [10, 25, 50, 100],
                pageLength: 10,
                dom: 'rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                buttons: [
                    { extend: 'copy', title: 'Account Reserves' },
                    { extend: 'csv', title: 'Account Reserves' },
                    { extend: 'excel', title: 'Account Reserves' },
                    { extend: 'pdf', title: 'Account Reserves' },
                    { extend: 'print', title: 'Account Reserves' }
                ],
                language: {
                    search: "",
                    searchPlaceholder: "Search accounts...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ accounts",
                    paginate: {
                        next: '<i class="fas fa-chevron-right"></i>',
                        previous: '<i class="fas fa-chevron-left"></i>'
                    }
                },
                columnDefs: [
                    //{ targets: 2, className: 'text-end fw-bold text-success' }, // Balance
                    { targets: 0, className: 'text-monospace' },              // Account Number
                    { targets: 4, className: 'text-center' },                 // Date
                    { targets: 5, orderable: false, className: 'text-center' } // Actions
                ]
            });

            // Custom buttons in toolbar
            var dtButtons = table.buttons().container().find('button');
            var customButtons = $('#customButtons');
            var buttonMeta = [
                { cls: 'btn-copy', icon: 'fa-copy', text: 'Copy' },
                { cls: 'btn-csv', icon: 'fa-file-csv', text: 'CSV' },
                { cls: 'btn-excel', icon: 'fa-file-excel', text: 'Excel' },
                { cls: 'btn-pdf', icon: 'fa-file-pdf', text: 'PDF' },
                { cls: 'btn-print', icon: 'fa-print', text: 'Print' }
            ];

            dtButtons.each(function (index) {
                var original = $(this);
                var meta = buttonMeta[index];
                if (!meta) return;
                var newButton = $('<button/>', {
                    class: 'btn-dt ' + meta.cls,
                    html: '<i class="fas ' + meta.icon + '"></i><span>' + meta.text + '</span>'
                });
                newButton.on('click', function () {
                    original.trigger('click');
                });
                customButtons.append(newButton);
            });

            // Style search input
            $('.dataTables_filter input')
                .addClass('form-control form-control-sm')
                .attr('placeholder', 'Search accounts...');
        });
    </script>
}