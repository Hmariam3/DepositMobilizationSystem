@model IEnumerable<TRMS.Models.AccountMapping>
@{
    ViewBag.Title = "Account Mappings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    :root {
        --primary: #00AEEF;
        --primary-dark: #008cc7;
        --primary-gradient: linear-gradient(135deg, #00AEEF, #0077b6);
        --success: #198754;
        --danger: #dc3545;
        --warning: #ffc107;
        --light: #f8f9fa;
        --dark: #212529;
        --gray: #6c757d;
        --border-radius: 1rem;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .index-container {
        width: 100%;
        margin: 0;
        padding: 0 1rem 2rem;
    }

    .toolbar-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        margin-bottom: 1.5rem;
        padding: 1rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .index-container .data-card {
        width: 100%;
    }

    .page-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

        .page-header h1 {
            font-weight: 800;
            font-size: 2.2rem;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 0.5px;
            margin: 0;
        }

        .page-header p {
            color: var(--gray);
            font-size: 1.1rem;
            margin-top: 0.5rem;
        }

    .data-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        overflow: hidden;
        transition: all 0.3s ease;
    }

        .data-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
        }

    .card-header {
        background: var(--primary-gradient);
        color: white;
        padding: 0.5rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 600;
        font-size: 1.3rem;
    }

        .card-header i {
            margin-right: 0.5rem;
        }

        .card-header .btn-create {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .card-header .btn-create:hover {
                background: white;
                color: var(--primary);
                transform: translateY(-2px);
            }

    .card-body {
        padding: 0;
    }

    .table {
        margin: 0;
        font-size: 0.95rem;
    }

        .table thead {
            background: #f1f3f5;
        }

            .table thead th {
                border: none;
                font-weight: 600;
                color: var(--dark);
                text-transform: uppercase;
                font-size: 0.8rem;
                letter-spacing: 0.5px;
                padding: 1rem;
            }

        .table tbody td {
            padding: 0.9rem 1rem;
            vertical-align: middle;
            border-color: #e9ecef;
        }

        .table tbody tr:hover {
            background: rgba(0, 174, 239, 0.05);
            transition: background 0.2s ease;
        }

    .btn-action {
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
        border-radius: 0.5rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .btn-details {
        background: #0dcaf0;
        color: white;
    }

        .btn-details:hover {
            background: #0aa8c7;
            transform: translateY(-1px);
        }

    .btn-delete {
        background: var(--danger);
        color: white;
    }

        .btn-delete:hover {
            background: #c82333;
            transform: translateY(-1px);
        }

    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        border-radius: 0.5rem;
        border: 1px solid #ced4da;
        padding: 0.35rem 0.75rem;
        font-size: 0.9rem;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        padding: 0.75rem 1rem;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            border-radius: 0.5rem;
            margin: 0 2px;
            padding: 0.5rem 0.75rem;
            font-weight: 600;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                background: var(--primary-gradient);
                border: none;
                color: white;
            }

    .alert {
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin: 1.5rem 0;
        border: none;
        font-weight: 500;
    }

    .alert-success {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
    }

    .alert-danger {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        color: #721c24;
    }

    .dt-buttons {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

        .dt-buttons .btn-dt {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.55rem 1rem;
            border-radius: 0.75rem;
            border: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

            .dt-buttons .btn-dt i {
                font-size: 1rem;
            }

        .dt-buttons .btn-copy {
            background: #eff3ff;
            color: #1d4ed8;
        }

        .dt-buttons .btn-csv {
            background: #ecfdf5;
            color: #059669;
        }

        .dt-buttons .btn-excel {
            background: #e6fffb;
            color: #0f766e;
        }

        .dt-buttons .btn-pdf {
            background: #fef2f2;
            color: #dc2626;
        }

        .dt-buttons .btn-print {
            background: #fff7ed;
            color: #c2410c;
        }

        .dt-buttons .btn-dt:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
        }

    @@media (max-width: 992px) {
        .toolbar-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .dt-buttons {
            width: 100%;
        }

            .dt-buttons .btn-dt {
                flex: 1;
                justify-content: center;
            }

        .card-header {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }

            .card-header .btn-create {
                width: 100%;
            }

        .table-responsive {
            border-radius: var(--border-radius);
            overflow: hidden;
        }
    }
</style>
<div class="index-container">
    <!-- Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Export Toolbar -->
    <div class="toolbar-card mt-3">
        <div>
            <h5 class="mb-1">Export & Tools</h5>
            <small class="text-muted">Download or print account mapping data quickly</small>
        </div>
        <div id="customButtons" class="dt-buttons"></div>
    </div>

    <!-- Main Data Card -->
    <div class="data-card">
        <div class="card-header">
            <div>
                <i class="fas fa-table"></i> Account Mappings
            </div>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Create", "AccountMappings")" class="btn-create">
                    <i class="fas fa-plus-circle me-1"></i> New Account Mapping
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="accountMappingTable" class="table table-striped table-hover" style="width:100%">
                    <thead>
                        <tr>
                            <th>Account Number</th>
                            <th>Account Holder</th>
                            <th>Beginning Balance</th>
                            <th>Current Balance</th>
                            <th>District</th>
                            <th>Branch</th>
                            <th>Username</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><code>@Html.DisplayFor(m => item.AccountNumber)</code></td>
                                <td class="fw-medium">@Html.DisplayFor(m => item.AccountHolder)</td>
                                <td class="text-end">@String.Format("{0:N2}", item.BegginingBalance)</td>
                                <td class="text-end">@String.Format("{0:N2}", item.CurrentBalance)</td>
                                <td>@Html.DisplayFor(m => item.District)</td>
                                <td>@Html.DisplayFor(m => item.Branch)</td>
                                <td>@Html.DisplayFor(m => item.UserName)</td>
                                <td>@Html.DisplayFor(m => item.CreatedDate, "{0:yyyy-MM-dd}")</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        @* @Html.ActionLink("Edit", "Edit", new { id = item.Acc_ID }, new { @class = "btn btn-edit btn-action" }) *@
                                        @Html.ActionLink("Details", "Details", new { id = item.Acc_ID }, new { @class = "btn btn-details btn-action" })
                                      @*  @Html.ActionLink("Delete", "Delete", new { id = item.Acc_ID }, new { @class = "btn btn-delete btn-action" })*@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#accountMappingTable').DataTable({
                responsive: true,
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                lengthMenu: [10, 25, 50, 100],
                pageLength: 10,
                dom: 'rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',   // no B → we move buttons manually
                buttons: [
                    { extend: 'copy', title: 'Account Mappings' },
                    { extend: 'csv', title: 'Account Mappings' },
                    { extend: 'excel', title: 'Account Mappings' },
                    { extend: 'pdf', title: 'Account Mappings' },
                    { extend: 'print', title: 'Account Mappings' }
                ],
                language: {
                    search: "",
                    searchPlaceholder: "Search mappings...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ mappings",
                    paginate: {
                        next: '<i class="fas fa-chevron-right"></i>',
                        previous: '<i class="fas fa-chevron-left"></i>'
                    }
                },
                columnDefs: [
                    { targets: 0, className: 'text-monospace' }, // Account Number
                    { targets: [2, 3], className: 'text-end fw-medium' }, // Balances
                    { targets: -1, orderable: false, className: 'text-center' } // Actions
                ],
                order: [[7, 'desc']] // Default sort by CreatedDate descending
            });

            // Move default buttons to custom toolbar with nice styling
            var dtButtons = table.buttons().container().find('button');
            var customButtons = $('#customButtons');

            var buttonMeta = [
                { cls: 'btn-copy', icon: 'fa-copy', text: 'Copy' },
                { cls: 'btn-csv', icon: 'fa-file-csv', text: 'CSV' },
                { cls: 'btn-excel', icon: 'fa-file-excel', text: 'Excel' },
                { cls: 'btn-pdf', icon: 'fa-file-pdf', text: 'PDF' },
                { cls: 'btn-print', icon: 'fa-print', text: 'Print' }
            ];

            dtButtons.each(function (index) {
                var original = $(this);
                var meta = buttonMeta[index];
                if (!meta) return;

                var newButton = $('<button/>', {
                    class: 'btn-dt ' + meta.cls,
                    html: '<i class="fas ' + meta.icon + '"></i><span>' + meta.text + '</span>'
                });

                newButton.on('click', function () {
                    original.trigger('click');
                });

                customButtons.append(newButton);
            });

            // Optional: improve search box appearance
            $('.dataTables_filter input')
                .addClass('form-control form-control-sm')
                .attr('placeholder', 'Search mappings...');
        });
    </script>
}