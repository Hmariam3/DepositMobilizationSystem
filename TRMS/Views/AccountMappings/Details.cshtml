@model TRMS.Models.AccountMapping
@{
    ViewBag.Title = "Account Mapping Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #00AEEF;
        --primary-gradient: linear-gradient(135deg, #00AEEF, #0077b6);
        --success: #198754;
        --info: #0dcaf0;
        --gray: #6c757d;
        --light: #f8f9fa;
        --dark: #212529;
        --border-radius: 1rem;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .detail-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .page-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }
    .page-header h1 {
        font-weight: 800;
        font-size: 2.2rem;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: 0.5px;
        margin: 0;
    }

    .detail-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        overflow: hidden;
    }

    .card-header {
        background: var(--primary-gradient);
        color: white;
        padding: 1rem 2rem;
        font-weight: 600;
        font-size: 1.3rem;
        text-align: center;
    }
    .card-header i {
        margin-right: 0.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-weight: 600;
        color: var(--dark);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .info-value {
        font-size: 1.1rem;
        color: var(--primary);
        font-weight: 500;
        word-break: break-all;
    }

    .info-value code {
        background: #f1f3f5;
        padding: 0.2rem 0.5rem;
        border-radius: 0.4rem;
        font-family: 'Courier New', monospace;
    }

    .info-value.balance {
        color: var(--success);
        font-weight: 700;
    }

    .btn-group-detail {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2.5rem;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-edit {
        background: var(--success);
        color: white;
    }
    .btn-edit:hover {
        background: #157347;
        transform: translateY(-2px);
    }

    .btn-back {
        background: var(--gray);
        color: white;
    }
    .btn-back:hover {
        background: #5a6268;
        transform: translateY(-2px);
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
        .card-body {
            padding: 1.5rem;
        }
        .btn-group-detail {
            flex-direction: column;
        }
        .btn-action {
            justify-content: center;
            width: 100%;
        }
    }
</style>

<div class="detail-container">
    <div class="detail-card mt-3">
        <div class="card-header">
            <i class="fas fa-table"></i> Account Mapping Details
        </div>

        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Account Number</div>
                    <div class="info-value"><code>@Html.DisplayFor(m => m.AccountNumber)</code></div>
                </div>

                <div class="info-item">
                    <div class="info-label">Account Holder</div>
                    <div class="info-value">@Html.DisplayFor(m => m.AccountHolder)</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Beginning Balance</div>
                    <div class="info-value balance">@String.Format("{0:N2}", Model.BegginingBalance)</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Current Balance</div>
                    <div class="info-value balance">@String.Format("{0:N2}", Model.CurrentBalance)</div>
                </div>

                <div class="info-item">
                    <div class="info-label">District</div>
                    <div class="info-value">@Html.DisplayFor(m => m.District)</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Branch</div>
                    <div class="info-value">@Html.DisplayFor(m => m.Branch)</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Username (Maker)</div>
                    <div class="info-value">@Html.DisplayFor(m => m.UserName)</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Created Date</div>
                    <div class="info-value">@Html.DisplayFor(m => m.CreatedDate, "{0:yyyy-MM-dd HH:mm}")</div>
                </div>
            </div>

            <div class="btn-group-detail">
                @*@Html.ActionLink("Edit", "Edit", new { id = Model.Acc_ID }, new { @class = "btn-action btn-edit" })*@
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn-action btn-back" })
            </div>
        </div>
    </div>
</div>