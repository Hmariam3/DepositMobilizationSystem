@model TRMS.Models.DepositPlanViewModel

@{
    ViewBag.Title = "Create Deposit Plan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style type="text/css">
    :root {
        --primary: #00AEEF;
        --primary-dark: #008cc7;
        --primary-gradient: linear-gradient(135deg, #00AEEF, #0077b6);
        --success: #198754;
        --danger: #dc3545;
        --warning: #ffc107;
        --light: #f8f9fa;
        --dark: #212529;
        --gray: #6c757d;
        --border-radius: 1rem;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }
    hr {
        width: 100%;
        height: 0.1px;
        background-color: #00AEEF;
        margin: 10px auto 5px;
        border-width: 2px;
        border-color: #00AEEF;
    }

    .alert {
        margin: 30px auto;
        width: 80%;
        font-family: Arial, sans-serif;
        font-weight: bold;
        text-align: center;
    }

    .form-control[readonly] {
        background-color: #e9ecef;
        opacity: 1;
    }

    .btn-validate {
        background-color: #00AEEF;
        color: white;
        /*margin-top: -50px;*/
        position: absolute;
        /*right: 15px;*/
    }

    .btn-save {
        background-color: #00AEEF;
        color: white;
    }

    .btn-back {
        background-color: #333;
        color: white;
    }

    .card-header {
        background: var(--primary-gradient);
        color: white;
        padding: 1rem 2rem;
        text-align: center;
        font-weight: 600;
        font-size: 1.3rem;
        letter-spacing: 0.5px;
    }

        .card-header i {
            margin-right: 0.5rem;
        }
    /* Ensure Select2 matches Bootstrap form-control */
    .select2-container--bootstrap-5 .select2-selection {
        height: calc(2rem + 2px); /* Same as form-control height */
        padding: 0rem 0.3rem;
        border: 1px solid #ced4da !important; /* Visible border */
        border-radius: 0.375rem; /* Same as Bootstrap */
        font-size: 0.95rem;
    }

    /* Align text vertically */
    .select2-container--bootstrap-5 .select2-selection__rendered {
        line-height: 2.2rem !important;
    }

    /* Adjust arrow position */
    .select2-container--bootstrap-5 .select2-selection__arrow {
        height: 100% !important;
        top: 0.5rem !important;
    }

    /* Scrollable dropdown results */
    .select2-results__options {
        max-height: 200px !important; /* Adjust scroll height */
        overflow-y: auto !important;
    }
    /* Position the clear 'x' button to the right */
    .select2-container--bootstrap-5 .select2-selection__clear {
        position: absolute;
        right: 2.2rem; /* keep space before arrow */
        top: 50%;
        transform: translateY(-50%);
        font-size: 1rem;
        color: #6c757d;
        cursor: pointer;
        opacity: 0.7;
    }

        /* Hover effect for better UX */
        .select2-container--bootstrap-5 .select2-selection__clear:hover {
            color: #dc3545;
            opacity: 1;
        }

    .blinking-warning {
            animation: blink 1.5s infinite;
        }
    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label,
    .form-floating > .form-select ~ label {
        color: #0d6efd;
    }
    .form-floating > .form-control.bg-light ~ label {
        color: #6c757d;
    }

    .text-shadow-sm {
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    }
</style>

<div class="card shadow-sm border-0 mt-4">

        <div class="card-header">
            <i class="fas fa-plus-circle me-2 fs-5"></i> New Deposit
        </div>

    <div class="card-body">

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <strong>Error!</strong> @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <strong>Success!</strong> @TempData["SuccessMessage"]
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                @{
                    string isoDate = "";

                    if (ViewBag.TXNDATE != null)
                    {
                        if (DateTime.TryParseExact(
                            ViewBag.TXNDATE.ToString(), "yyyyMMdd",
                            System.Globalization.CultureInfo.InvariantCulture,
                            System.Globalization.DateTimeStyles.None,
                            out DateTime dt))
                        {
                            isoDate = dt.ToString("yyyy-MM-dd");
                        }
                    }
                }

                @using (Html.BeginForm("Create", "DepositPlans", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-4" })

                    <!-- Row 1: Account Number + Reference Number -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.EditorFor(model => model.DepositPlan.AccountNumber, new { htmlAttributes = new { @class = "form-control", placeholder = "Account Number" } })
                                @Html.LabelFor(model => model.DepositPlan.AccountNumber, "Account Number")
                                @Html.ValidationMessageFor(model => model.DepositPlan.AccountNumber, "", new { @class = "text-danger small mt-1" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.EditorFor(model => model.DepositPlan.ReferenceNumber, new { htmlAttributes = new { @class = "form-control", placeholder = "Reference Number" } })
                                @Html.LabelFor(model => model.DepositPlan.ReferenceNumber, "Reference Number")
                                @Html.ValidationMessageFor(model => model.DepositPlan.ReferenceNumber, "", new { @class = "text-danger small mt-1" })
                            </div>
                            @*<div class="mt-2">
                        <input type="submit" name="submit" value="Validate" class="btn btn-info text-white w-100" />
                    </div>*@
                            <div class="mt-2">
                                <input type="submit" name="submit" value="Validate" class="btn btn-outline-primary btn-sm px-4" />
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Account Holder + Amount -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.EditorFor(model => model.DepositPlan.AccountHolder, new { htmlAttributes = new { @class = "form-control bg-light", @Value = ViewBag.AccountHolder, @readonly = "readonly", placeholder = "Account Holder" } })
                                @Html.LabelFor(model => model.DepositPlan.AccountHolder, "Account Holder")
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.EditorFor(model => model.DepositPlan.Amount, new { htmlAttributes = new { @class = "form-control bg-light", @Value = ViewBag.TransactionAmount, @readonly = "readonly", placeholder = "Amount" } })
                                <label>Amount</label>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden Account Balance -->
                    <div style="display: none;">
                        @Html.EditorFor(model => model.DepositPlan.AccountBalance, new { htmlAttributes = new { @Value = ViewBag.AccountBalance } })
                    </div>
                    <!-- previous Initial Account Balance -->
                    <div style="display: none;">
                        @Html.EditorFor(model => model.DepositPlan.Prev_Ini_Bal, new { htmlAttributes = new { @Value = ViewBag.PreviousBalance } })
                    </div>
                    <div class="form-floating mb-3">
                        <input type="date"
                               name="DepositPlan.RefDate"
                               id="DepositPlan_RefDate"
                               value="@isoDate"
                               class="form-control"
                               readonly />

                        <label for="DepositPlan_RefDate">Reference Date</label>
                    </div>
                    <!-- Row 3: Share Deposit + Deposit Type (Manager Only) -->
                    <div class="row g-3 mb-3 align-items-center">
                        <!-- Share Deposit Checkbox -->
                        @Html.CheckBoxFor(m => m.ShareDeposit, new { id = "ShareDepositCheckbox", style = "position:absolute; left:-9999px;" })
                        <div id="shareCheckboxWrapper">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="ShareDepositCheckboxVisible" />
                                    <label class="form-check-label fw-medium text-secondary" for="ShareDepositCheckboxVisible">
                                        Share Deposit
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Deposit Type (Branch Manager Only) -->
                        @if (Session["Position"]?.ToString() == "BranchManager")
                        {
                            <div class="col-md-6">
                                <div class="form-floating">
                                    @Html.DropDownListFor(
                                        m => m.DepositPlan.DepositType,
                                        new SelectList(new[] { "Individual", "Branch" }),
                                        "Select Deposit For",
                                        new { @class = "form-select", id = "DepositTypeSelect" })
                                    <label>Deposit Type</label>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Shared Users Section -->
                    <div id="sharedSection" class="border rounded p-4 " style="display:none;">
                        <h5 class="mb-3 text-primary">
                            <i class="fas fa-users me-2"></i>Shared Users
                        </h5>
                        <div id="shareGuidance" class="alert alert-warning py-2 px-3 mb-3 small blinking-warning" role="alert">
                            Don't Forget to fill your amount Please.
                        </div>
                        <hr class="my-3">
                        @for (int i = 1; i <= 3; i++)
                        {
                            var isFirst = i == 1;
                            var userText = isFirst ? $"{Session["FullName"]} ({Session["UserName"]})" : "";
                            var userId = isFirst ? Session["Userid"]?.ToString() : "";

                            <div class="row g-3 mb-3 align-items-end">
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">User @i</label>
                                    @if (isFirst)
                                    {
                                        <select class="form-select bg-light" disabled>
                                            <option value="@userId" selected>@userText</option>
                                        </select>
                                        <input type="hidden" name="SharedUser1" value="@Session["UserName"]" />
                                    }
                                    else
                                    {
                                        @Html.DropDownList($"SharedUser{i}", Enumerable.Empty<SelectListItem>(), "Search User",
                                            new { @class = "form-select user-search", id = $"SharedUser{i}" })
                                    }
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">Amount</label>
                                    <input type="number" name="@($"SharedAmount{i}")" class="form-control" step="0.01" placeholder="0.00" />
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Shared Amount Warning -->
                    <div id="sharedAmountWarning" class="text-danger fw-bold mt-2" style="display:none; margin-left:15px;"></div>

                    <!-- Action Buttons -->
                    <div class="mt-4 text-end">
                        <input type="submit" name="submit" value="Save" class="btn btn-primary px-5" style="background: linear-gradient(135deg, #00AEEF, #0077b6); border:none;" />
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Styles.Render("~/Content/cssjqryUi")
    @Scripts.Render("~/bundles/jqueryui")
    @*<script src="~/Content/jquery-3.6.0.min.js"></script>*@
    <!-- ✅ Put jQuery BEFORE Select2 -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <script src="~/dist/js/select2.min.js"></script>
    <link href="~/dist/css/select2.min.css" rel="stylesheet" />
    <script>
    $(document).ready(function () {
        console.log("✅ jQuery and Select2 initialized");

        // Ensure all .user-search dropdowns are enhanced
        $('.user-search').each(function () {
            $(this).select2({
                placeholder: "Search user...",
                allowClear: true,
                minimumInputLength: 1,
                width: '100%',
                ajax: {
                    url: '@Url.Action("SearchUsers", "DepositPlans")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term || '',
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.items,
                            pagination: {
                                more: data.hasMore
                            }
                        };
                    },
                    cache: true
                },
                templateResult: function (data) {
                    if (data.loading) return data.text;
                    return $("<div><strong>" + data.text + "</strong></div>");
                },
                templateSelection: function (data) {
                    return data.text || "Search user...";
                }
            });
        });

        // ✅ Debug message to verify connection
        $('.user-search').on('select2:open', function () {
            console.log("🟢 Select2 dropdown opened for:", this.id);
        });
    });
    </script>


    <script>
    $(document).ready(function () {


        // ------------------------------------------------------------------
        // @Html.CheckBoxFor(m => m.ShareDeposit, new { id = "ShareDepositCheckbox", style = "position:absolute; left:-9999px;" })
        // This is rendered outside the visible wrapper but always in DOM


        // Sync visible checkbox with hidden model-bound one
        $('#ShareDepositCheckboxVisible').on('change', function () {
            var isChecked = this.checked;
            $('#ShareDepositCheckbox').prop('checked', isChecked);

            if (isChecked) {
                $('#sharedSection').slideDown(300);
            } else {
                clearSharedSection();
                $('#sharedSection').slideUp(300);
            }
        });

        // Sync hidden → visible on page load (e.g., edit form)
        if ($('#ShareDepositCheckbox').is(':checked')) {
            $('#ShareDepositCheckboxVisible').prop('checked', true);
            $('#sharedSection').show();
        }


        // 3. Control visibility of Share Deposit checkbox based on Deposit Type

        function updateShareCheckboxVisibility() {
            var depositType = $('#DepositTypeSelect').val();

            if (depositType === 'Branch') {
                $('#shareCheckboxWrapper').fadeOut(200);
                $('#ShareDepositCheckbox').prop('checked', false);
                $('#ShareDepositCheckboxVisible').prop('checked', false);
                clearSharedSection();
                $('#sharedSection').slideUp(300);
            } else {
                $('#shareCheckboxWrapper').fadeIn(200);
            }
        }

        $('#DepositTypeSelect').on('change', updateShareCheckboxVisibility);
        updateShareCheckboxVisibility(); // Run on load


        // 5. Clear all fields in #sharedSection

        function clearSharedSection() {
            $('#sharedSection').find('select, input').each(function () {
                var $el = $(this);
                if ($el.is('select')) {
                    $el.val('').trigger('change'); // Clear Select2
                } else if ($el.is(':checkbox,:radio')) {
                    $el.prop('checked', false);
                } else {
                    $el.val('');
                }
            });
        }


        // 6. Form submit validation (only if checkbox is checked)

        $('input[name="submit"][value="Save"]').prop('disabled', sumShared > depositAmount || sumShared === 0);

        $('form').on('submit', function (e) {
            if (!$('#ShareDepositCheckbox').is(':checked')) {
                return true; // Skip validation when not shared
            }

            // Read the main amount (convert formatted or empty to 0)
            var depositAmount = parseFloat($('#DepositPlan_Amount').val().replace(/,/g, '')) || 0;
            var sumShared = 0;

            // Calculate total of shared amounts
            for (var i = 1; i <= 3; i++) {
                var amt = parseFloat($('input[name="SharedAmount' + i + '"]').val()) || 0;
                sumShared += amt;
            }

            if (sumShared > depositAmount) {
                alert('❌ The sum of shared user amounts (' + sumShared.toFixed(2) + ') cannot exceed the main deposit amount (' + depositAmount.toFixed(2) + ').');
                e.preventDefault();
                return false;
            }

            if (sumShared === 0) {
                alert('Please assign at least one shared amount greater than 0.');
                e.preventDefault();
                return false;
            }

            return true;
        });


        // Live real-time validation and visual feedback

        $('input[name^="SharedAmount"]').on('input', function () {
            var depositAmount = parseFloat($('#DepositPlan_Amount').val().replace(/,/g, '')) || 0;
            var sumShared = 0;

            for (var i = 1; i <= 3; i++) {
                sumShared += parseFloat($('input[name="SharedAmount' + i + '"]').val()) || 0;
            }

            var $warning = $('#sharedAmountWarning');

            if (sumShared > depositAmount) {
                $('input[name^="SharedAmount"]').css('border', '2px solid red');
                $warning.text('⚠️ The total shared amount (' + sumShared.toFixed(2) + ') exceeds the main deposit amount (' + depositAmount.toFixed(2) + ').')
                    .fadeIn(200);
            } else if (sumShared === 0) {
                $('input[name^="SharedAmount"]').css('border', '');
                $warning.text('Please enter at least one valid shared amount.').fadeIn(200);
            } else {
                $('input[name^="SharedAmount"]').css('border', '');
                $warning.fadeOut(200);
            }
        });



        // 7. Datepicker & other unrelated toggles

        $('input[type=datetime]').datepicker({
            dateFormat: "dd/M/yy",
            changeMonth: true,
            changeYear: true,
            yearRange: "1950:+1"
        });

        function toggleTransactionBranch() {
            var selectedValue = $("#ChannalDropdown").val();
            $("#TransactionBranchDiv").toggle(selectedValue === "Branch");
        }

        function toggleTransactionCollect() {
            var selectedValue = $("#CollectedDropdown").val();
            $("#CollctionTypeDiv").toggle(selectedValue === "Joint");
        }

        toggleTransactionBranch();
        toggleTransactionCollect();

        $("#ChannalDropdown").change(toggleTransactionBranch);
        $("#CollectedDropdown").change(toggleTransactionCollect);
    });
    </script>
}
