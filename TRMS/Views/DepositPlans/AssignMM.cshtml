@{
    ViewBag.Title = "Assign MM Reference";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #00AEEF;
        --primary-dark: #008cc7;
        --primary-gradient: linear-gradient(135deg, #00AEEF, #0077b6);
        --success: #198754;
        --danger: #dc3545;
        --warning: #ffc107;
        --light: #f8f9fa;
        --dark: #212529;
        --gray: #6c757d;
        --border-radius: 1rem;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .assign-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 1rem;
    }

    .page-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .page-header h1 {
        font-weight: 800;
        font-size: 2.2rem;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: 0.5px;
        margin: 0;
    }

    .page-header p {
        color: var(--gray);
        font-size: 1.1rem;
        margin-top: 0.5rem;
    }

    .form-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .form-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    }

    .card-header {
        background: var(--primary-gradient);
        color: white;
        padding: 1rem 2rem;
        text-align: center;
        font-weight: 600;
        font-size: 1.3rem;
        letter-spacing: 0.5px;
    }

    .card-header i {
        margin-right: 0.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    .form-label {
        font-weight: 600;
        color: var(--dark);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-control,
    .form-select {
        border-radius: 0.75rem;
        border: 1px solid #ced4da;
        padding: 0.65rem 1rem;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 0.2rem rgba(0, 174, 239, 0.25);
    }

    .form-control[readonly] {
        background: #e9ecef;
        cursor: not-allowed;
    }

    .btn-container {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e9ecef;
    }

    .btn-validate,
    .btn-save {
        background: var(--primary-gradient);
        border: none;
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .btn-validate:hover,
    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 174, 239, 0.4);
    }

    .btn-save {
        background: linear-gradient(135deg, #198754, #157347);
    }

    .btn-save:hover {
        box-shadow: 0 8px 20px rgba(25, 135, 84, 0.4);
    }

    .alert {
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin-top: 1.5rem;
        border: none;
        font-weight: 500;
    }

    .alert-success {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
    }

    .alert-danger {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        color: #721c24;
    }

    .alert i {
        margin-right: 0.5rem;
    }
    /* Fix border, radius and height for Select2 Bootstrap 5 */
    .select2-container--bootstrap-5 .select2-selection {
        border: 1px solid #ced4da !important;
        border-radius: 0.75rem !important;
        padding: 0.55rem 0.75rem !important;
        height: auto !important;
        min-height: 41px !important;
    }

    /* Focus border for Select2 */
    .select2-container--bootstrap-5.select2-container--focus .select2-selection {
        border-color: var(--primary) !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 174, 239, 0.25) !important;
    }

    /* Placeholder & text style */
    .select2-container--bootstrap-5 .select2-selection__rendered {
        font-size: 0.95rem;
        color: #495057;
        padding-left: 2px !important;
    }


    @@media (max-width: 768px) {
        .page-header h1 {
            font-size: 1.8rem;
        }

        .card-body {
            padding: 1.5rem;
        }

        .btn-container {
            flex-direction: column;
        }

        .btn-validate,
        .btn-save {
            width: 100%;
        }
    }
</style>

<div class="assign-container">
    <!-- Page Header -->
    @*<div class="page-header">
        <h1>Assign MM Reference</h1>
        <p>Validate and assign MM references to accounts</p>
    </div>*@

    <!-- Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Error!</strong> @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            <strong>Success!</strong> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Form Card -->
    <div class="form-card">
        <div class="card-header">
            <i class="fas fa-link"></i> Assign MM Reference
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Select Account <span class="text-danger">*</span></label>
                    @Html.DropDownList("AccountNumber",
                        (SelectList)ViewBag.AccountList,
                        "Select Account",
                        new { @class = "form-select", id = "account" })
                    @Html.ValidationMessage("AccountNumber", "", new { @class = "text-danger small mt-1" })
                </div>
                <div class="col-md-4">
                    <label class="form-label">MM Reference <span class="text-danger">*</span></label>
                    <input type="text" id="mmref" class="form-control" placeholder="Enter MM reference" />
                    @Html.ValidationMessage("mmref", "", new { @class = "text-danger small mt-1" })
                </div>
                <div class="col-md-4">
                    <label class="form-label">Amount</label>
                    <input type="text" id="amount" class="form-control" readonly placeholder="Auto-filled after validation" />
                </div>
            </div>
            <div id="msg" class="mt-3"></div>
            <div class="btn-container">
                <button class="btn btn-validate" onclick="validateMM()">
                    <i class="fas fa-check-circle"></i> Validate
                </button>
                <button class="btn btn-save" onclick="saveMM()">
                    <i class="fas fa-save"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Initialize Select2 with AJAX search
        $('#account').select2({
            theme: 'bootstrap-5',
            width: '100%',
            placeholder: "Enter Account",
            minimumInputLength: 2, // Minimum characters before searching
            ajax: {
                url: '@Url.Action("SearchAccounts", "DepositPlans")',
                dataType: 'json',
                delay: 250, // Delay in ms after typing
                data: function (params) {
                    return {
                        term: params.term // search term
                    };
                },
                processResults: function (data) {
                    return {
                        results: data
                    };
                },
                cache: true
            }
        });

        // Optional: If you want to add account creation on the fly
        $('#account').on('select2:select', function (e) {
            console.log('Selected:', e.params.data);
        });
    });

    // Rest of your validateMM() and saveMM() functions remain the same
    function validateMM() {
        var account = $("#account").val();
        var mmref = $("#mmref").val();

        if (!account || !mmref) {
            $("#msg").html(
                "<div class='alert alert-danger'>" +
                "<i class='fas fa-exclamation-triangle'></i> Please select an account and enter MM reference." +
                "</div>"
            );
            return;
        }

        $("#msg").html("<div class='alert alert-info'><i class='fas fa-spinner fa-spin'></i> Validating...</div>");
        $.post("@Url.Action("ValidateMM")", {
            accountNumber: account,
            mmReference: mmref
        }, function (res) {
            if (res.success) {
                $("#amount").val(res.amount);
                $("#msg").html(
                    "<div class='alert alert-success'>" +
                    "<i class='fas fa-check-circle'></i> MM validated successfully." +
                    "</div>"
                );
            } else {
                $("#msg").html(
                    "<div class='alert alert-danger'>" +
                    "<i class='fas fa-exclamation-triangle'></i> " + res.message +
                    "</div>"
                );
            }
        }).fail(function () {
            $("#msg").html(
                "<div class='alert alert-danger'>" +
                "<i class='fas fa-exclamation-triangle'></i> An error occurred while validating." +
                "</div>"
            );
        });
    }

    function saveMM() {
        var account = $("#account").val();
        var mmref = $("#mmref").val();

        if (!account || !mmref) {
            $("#msg").html(
                "<div class='alert alert-danger'>" +
                "<i class='fas fa-exclamation-triangle'></i> Please select an account and enter MM reference." +
                "</div>"
            );
            return;
        }

        $("#msg").html("<div class='alert alert-info'><i class='fas fa-spinner fa-spin'></i> Saving...</div>");
        $.post("@Url.Action("SaveMM")", {
            accountNumber: account,
            mmReference: mmref,
            amount: $("#amount").val()
        }, function (res) {
            if (res.success) {
                $("#msg").html(
                    "<div class='alert alert-success'>" +
                    "<i class='fas fa-check-circle'></i> " + res.message +
                    "</div>"
                );
                // Optional: Clear form after successful save
                $("#mmref").val('');
                $("#amount").val('');
            } else {
                $("#msg").html(
                    "<div class='alert alert-danger'>" +
                    "<i class='fas fa-exclamation-triangle'></i> " + res.message +
                    "</div>"
                );
            }
        }).fail(function () {
            $("#msg").html(
                "<div class='alert alert-danger'>" +
                "<i class='fas fa-exclamation-triangle'></i> An error occurred while saving." +
                "</div>"
            );
        });
    }
</script>