@model List<TRMS.Models.Report.EcoShareReportVM>

@{
    ViewBag.Title = "Auto(ECO-Share) Report";
}

<div class="panel panel-default" style="padding:15px;">
    <div class="panel-heading">
        <h3>
            <i class="fa fa-share-alt text-primary"></i>
            Auto(ECO-Share) Report
        </h3>
    </div>
    <hr />

    <!-- Summary -->
    <div class="alert alert-info mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>Auto-Share Summary</strong>
                <span class="badge bg-primary ms-2">ECO Share</span>
            </div>
            <div>
                <strong>Total Records: @Model.Count</strong>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>No</th>
                    <th>Full Name</th>
                    <th>Process</th>
                    <th>District</th>
                    <th>Branch</th>
                    <th>Account Holder</th>
                    <th>Account Number</th>
                    <th>Reference</th>
                    <th>Amount</th>
                    <th>Ref Date</th>
                    @*<th>Created Date</th>*@
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="11" class="text-center text-danger">No records found.</td>
                    </tr>
                }
                else
                {
                    int sn = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@sn</td>
                            <td>@item.FullName</td>
                            <td>@item.Process</td>
                            <td>@item.District</td>
                            <td>@item.Branch</td>
                            <td>@item.AccountHolder</td>
                            <td>@item.AccountNumber</td>
                            <td>@item.ReferenceNumber</td>
                            <td>@item.Amount.ToString("N2")</td>
                            <td>@(item.RefDate?.ToString("yyyy-MM-dd"))</td>
                            @*<td>@item.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>*@
                        </tr>
                        sn++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
