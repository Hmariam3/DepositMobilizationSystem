@{
    ViewBag.Title = "Deposit Achievement Report";
}
<div class="panel panel-default" style="padding:15px;">
    <div class="panel-heading">
        <h3>
            <i class="fa fa-trophy text-warning"></i>
            <span id="reportTitle">Loading Report...</span>
        </h3>
    </div>
    <hr />

    <!-- Filters -->
    <div id="filterSection">
        <form id="filterForm" class="mb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <label><strong>Start Date</strong></label>
                    <input type="date" id="startDate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label><strong>End Date</strong></label>
                    <input type="date" id="endDate" class="form-control" />
                </div>
                <div class="col-md-3" id="districtFilter" style="display:none;">
                    <label><strong>District</strong></label>
                    <select id="district" class="form-control">
                        <option value="All">All Districts</option>
                        @foreach (var d in ViewBag.District)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Apply Filter</button>
                    <button type="button" id="btnReset" class="btn btn-secondary">Reset</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Summary Alert - Removed "Collected" -->
    <div class="alert alert-success mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>Total Summary</strong>
                <span class="badge bg-primary ms-2">Deposit Report</span>
            </div>
            <div class="d-flex gap-4">
                <strong>Total Target: <span id="grandTotalTarget">Loading...</span></strong>
                <strong>Total Achieved: <span id="grandTotalAchieved">Loading...</span></strong>
                <strong>Achievement: <span id="grandTotalPercentage" class="badge bg-secondary">Loading...</span></strong>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="achievementTable" class="table table-bordered table-hover" style="width:100%">
            <thead class="table-dark">
                <tr>
                    <th>No</th>
                    <th>Full Name</th>
                    <th>Process</th>
                    <th>District/Subprocess</th>
                    <th>Branch/Team</th>
                    <th>Target</th>
                    <th>Achieved</th>
                    <th>% Achieved</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <button id="btnExport" class="btn btn-success mt-3">
        Export to Excel
    </button>
</div>

@section Scripts {
    <script>
$(document).ready(function () {
    var currentUser = {
        role: "@ViewBag.CurrentUserRole",
        position: "@ViewBag.CurrentUserPosition",
        process: "@ViewBag.CurrentUserProcess",
        district: "@ViewBag.CurrentUserDistrict",
        branch: "@ViewBag.CurrentUserBranch",
        fullName: "@ViewBag.CurrentUserFullName"
    };

    var filterMode = "";
    var fixedFilter = {};

    // Set report title and filters based on role
    if (currentUser.role === "Super") {
        $("#reportTitle").text("Bank-Wide Deposit Achievement Report");
        $("#districtFilter").show();
        filterMode = "bank";
    }
    else if (currentUser.role === "Maker") {
        if (["VP", "CHF"].includes(currentUser.position)) {
            $("#reportTitle").text(`Process: ${currentUser.process} - Achievement Report`);
            filterMode = "process";
            fixedFilter.process = currentUser.process;
        }
        else if (["Director", "SeniorDirector"].includes(currentUser.position)) {
            $("#reportTitle").text(`Subprocess: ${currentUser.district} - Achievement Report`);
            filterMode = "subprocess";
            fixedFilter.district = currentUser.district;
            $("#districtFilter").show().find("select").val(currentUser.district).prop("disabled", true);
        }
        else if (["BranchManager", "Manager"].includes(currentUser.position)) {
            $("#reportTitle").text(`Branch: ${currentUser.branch} - Achievement Report`);
            filterMode = "branch";
            fixedFilter.branch = currentUser.branch;
        }
        else {
            $("#reportTitle").text(`My Performance: ${currentUser.fullName}`);
            filterMode = "self";
            fixedFilter.userName = "@ViewBag.CurrentUserName";
            $("#filterSection").hide();
        }
    }

    var table = $('#achievementTable').DataTable({
        "processing": true,
        "serverSide": true,
        "ajax": {
            "url": "@Url.Action("SmartAchievementReportAjax")",
            "type": "POST",
            "data": function (d) {
                d.startDate = $('#startDate').val();
                d.endDate = $('#endDate').val();
                d.district = $('#district').val();
                d.filterMode = filterMode;
                d.fixedProcess = fixedFilter.process || "";
                d.fixedDistrict = fixedFilter.district || "";
                d.fixedBranch = fixedFilter.branch || "";
                d.fixedUserName = fixedFilter.userName || "";
            }
        },
        "pageLength": 25,
        "order": [[7, "desc"]], // Sort by % Achieved
        "columns": [
            { "data": null, "orderable": false, render: (data, type, row, meta) => meta.row + meta.settings._iDisplayStart + 1 },
            { "data": "FullName" },
            { "data": "Process" },
            { "data": "District" },
            { "data": "Branch" },
            { "data": "Target", render: $.fn.dataTable.render.number(',', '.', 2) },
            { "data": "Achieved", render: $.fn.dataTable.render.number(',', '.', 2) },
            {
                "data": "Percentage",
                "render": function (d) {
                    var color = d >= 100 ? 'success' : d >= 80 ? 'warning' : 'danger';
                    return `<span class="badge bg-${color}">${parseFloat(d).toFixed(1)}%</span>`;
                }
            }
        ],
        "drawCallback": function (settings) {
            var json = settings.json;
            if (json) {
                $('#grandTotalTarget').text(json.grandTotalTarget || '0.00');
                $('#grandTotalAchieved').text(json.grandTotalAchieved || '0.00');

                var pct = parseFloat(json.grandTotalPercentage || 0);
                var $badge = $('#grandTotalPercentage');

                $badge.text(pct.toFixed(1) + '%')
                    .removeClass('bg-success bg-warning bg-danger')
                    .addClass(pct >= 100 ? 'bg-success' :
                        pct >= 80 ? 'bg-warning' : 'bg-danger');
            }
        }
    });

    $('#filterForm').on('submit', function (e) {
        e.preventDefault();
        table.ajax.reload();
    });

    $('#btnReset').click(function () {
        $('#startDate, #endDate').val('');
        if ($('#district').is(':visible') && !$('#district').prop('disabled')) {
            $('#district').val('All');
        }
        table.ajax.reload();
    });

    // EXPORT TO EXCEL - Client-side (All Data)
    $('#btnExport').click(function () {
        const $btn = $(this).prop('disabled', true).html('Exporting...');
        const currentLength = table.page.len();
        const currentPage = table.page();

        table.page.len(-1).draw();

        table.one('draw', function () {
            try {
                const allData = table.rows().data().toArray();
                const json = table.settings()[0].json;

                let exportData = [];
                exportData.push(["DEPOSIT ACHIEVEMENT REPORT"]);
                exportData.push([]);
                exportData.push([`Period: ${$('#startDate').val() ? $('#startDate').val() + " to " + ($('#endDate').val() || "Present") : "All Time"}`]);
                exportData.push([`Scope: ${$("#reportTitle").text().trim()}`]);
                exportData.push([`Generated: ${moment().format('dddd, DD MMMM YYYY [at] HH:mm')}`]);
                exportData.push([`Total Records: ${allData.length.toLocaleString()}`]);
                exportData.push([]);

                // Header (8 columns now)
                exportData.push([
                    "No", "Full Name", "Process", "District/Subprocess", "Branch/Team",
                    "Target", "Achieved", "% Achieved"
                ]);

                allData.forEach((row, i) => {
                    exportData.push([
                        i + 1,
                        (row.FullName || "N/A").trim(),
                        row.Process || "-",
                        row.District || "-",
                        row.Branch || "-",
                        parseFloat(row.Target || 0),
                        parseFloat(row.Achieved || 0),
                        (parseFloat(row.Percentage || 0)) / 100
                    ]);
                });

                // Grand Total
                const gTarget = parseFloat((json?.grandTotalTarget || "0").replace(/,/g, ''));
                const gAchieved = parseFloat((json?.grandTotalAchieved || "0").replace(/,/g, ''));
                const gPct = gTarget > 0 ? (gAchieved / gTarget) * 100 : 0;

                exportData.push([]);
                exportData.push(["GRAND TOTAL", "", "", "", "", gTarget, gAchieved, gPct / 100]);

                const wb = XLSX.utils.book_new();
                const ws = XLSX.utils.aoa_to_sheet(exportData);
                const range = XLSX.utils.decode_range(ws['!ref']);

                // Styling
                for (let R = 0; R <= range.e.r; ++R) {
                    for (let C = 0; C <= range.e.c; ++C) {
                        const addr = XLSX.utils.encode_cell({ r: R, c: C });
                        if (!ws[addr]) continue;
                        const cell = ws[addr];

                        if (R === 0) {
                            cell.s = { font: { bold: true, sz: 18, color: { rgb: "1F4E79" } }, alignment: { horizontal: "center" } };
                        }
                        else if (R >= 2 && R <= 5) {
                            cell.s = { font: { italic: true, color: { rgb: "555555" } } };
                        }
                        else if (R === 7) {
                            cell.s = { font: { bold: true, color: { rgb: "FFFFFF" } }, fill: { fgColor: { rgb: "366092" } }, alignment: { horizontal: "center" } };
                        }
                        else if (R >= 8) {
                            const isTotal = R === exportData.length - 1;
                            cell.s = {
                                font: { bold: isTotal },
                                fill: isTotal ? { fgColor: { rgb: "D9E2F3" } } : undefined,
                                alignment: { horizontal: C >= 5 ? "right" : "left" },
                                border: { top: { style: "thin" }, bottom: { style: isTotal ? "double" : "thin" }, left: { style: "thin" }, right: { style: "thin" } }
                            };
                            if (C === 7 && !isTotal) { // % Achieved column
                                const val = (cell.v || 0) * 100;
                                const color = val >= 100 ? "27AE60" : val >= 80 ? "E67E22" : "E74C3C";
                                cell.s.font = { bold: true, color: { rgb: color } };
                            }
                        }
                    }
                }

                ws['!cols'] = [
                    { wch: 6 }, { wch: 28 }, { wch: 16 }, { wch: 22 }, { wch: 20 },
                    { wch: 16 }, { wch: 16 }, { wch: 14 }
                ];

                ws['!merges'] = [
                    { s: { r: 0, c: 0 }, e: { r: 0, c: 7 } },
                    { s: { r: 2, c: 0 }, e: { r: 2, c: 7 } },
                    { s: { r: 3, c: 0 }, e: { r: 3, c: 7 } },
                    { s: { r: 4, c: 0 }, e: { r: 4, c: 7 } },
                    { s: { r: 5, c: 0 }, e: { r: 5, c: 7 } },
                    { s: { r: exportData.length - 1, c: 0 }, e: { r: exportData.length - 1, c: 4 } }
                ];

                // Number formats
                for (let r = 8; r < exportData.length - 1; r++) {
                    ['F', 'G'].forEach(col => { const c = ws[col + (r + 1)]; if (c) c.z = "#,##0.00"; });
                    const pc = ws['H' + (r + 1)]; if (pc) pc.z = "0.00%";
                }
                ['F', 'G', 'H'].forEach(col => {
                    const c = ws[col + exportData.length];
                    if (c) c.z = col === 'H' ? "0.00%" : "#,##0.00";
                });

                XLSX.utils.book_append_sheet(wb, ws, "Achievement Report");
                XLSX.writeFile(wb, `Deposit_Achievement_${moment().format('YYYYMMDD_HHmm')}.xlsx`);

                toastr.success(`Exported ${allData.length.toLocaleString()} records!`);
            } catch (err) {
                console.error(err);
                toastr.error("Export failed!");
            } finally {
                table.page.len(currentLength).page(currentPage).draw('page');
                $btn.prop('disabled', false).html('Export to Excel');
            }
        });
    });
});
    </script>
}