<body class="hold-transition skin-red sidebar-mini">
    <div class="wrapper" style="margin-top:2px;">
        <!-- Main Header -->
        <header class="main-header">
            <!-- Logo -->
            <a href="index" class="logo" style="background-color:#00AEEF ;height:70px;" >
                <!-- mini logo for sidebar mini 50x50 pixels -->
                <img src="~/Content/Image/coplog.png" alt="" width="50" height="50" class="logo-mini pull-left" />
                <!-- logo for regular state and mobile devices -->

                <span class="logo-lg" ><img class="manImg" src="~/Content/Image/coplog.png" width="235" height="60" style="margin-left:-20px;"></img></span>
            </a>

            <!-- Logo -->
            @*<a href="index" class="logo">*@
            <!-- mini logo for sidebar mini 50x50 pixels -->
            @*<img src="~/Content/Image/Tsehaylogo9.PNG" width="230" height="50" class="logo-mini pull-left" />*@
            <!-- logo for regular state and mobile devices -->
            @*</a>*@

            <!-- Header Navbar -->
            <nav class="navbar navbar-static-top" role="navigation" style="color:#f0ce0d;background-color:#00AEEF;height:70px;" >

                <span style="font-size:3em;color:white;margin-left:3em;"><b>Deposit Monitoring System</b></span>
                <!-- Sidebar toggle button-->
                <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button" style="color:#f0ce0d;background-color:#00AEEF">
                    <span class="sr-only">Toggle navigation</span>
                </a>
                <!-- Navbar Right Menu -->
                <div class="navbar-custom-menu">
                    <ul class="nav navbar-nav">

                        <!-- User Account Menu -->
                        <li class="dropdown user user-menu">
                            <!-- Menu Toggle Button -->
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                <!-- The user image in the navbar-->
                                <img src="~/Content/Image/user-default.png" class="user-image" alt="User Image">
                               
                                <!-- hidden-xs hides the username on small devices so only the image appears. -->
                              
                               
                                @if (Session["username"] != null)
                                {
                                    <span class="hidden-xs">@Session["username"].ToString()</span>
                                }
                            </a>
                            <ul class="dropdown-menu" style="background-color:#00AEEF">
                                <!-- The user image in the menu -->
                                <li class="user-header" style="background-color:#f0ce0d">
                                    <img src="~/Content/Image/user-default.png" class="img-circle" alt="User Image">
                                    @if (Session["username"] != null)
                                    {
                                        <p>
                                            @Session["username"].ToString()
                                        </p>
                                    }
                                </li>
                                <!-- Menu Body -->
                                <!-- Menu Footer-->
                                <li class="user-footer" style="background-color: #e0f7fa; padding: 12px 15px; border-top: 2px solid #00acc1;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        @Html.ActionLink("Update Profile", "UpdateProfile", "User", new { id = Session["Userid"] }, new { @class = "btn btn-info btn-sm text-white fw-bold", style = "background-color:#00acc1; border:none; border-radius:5px; width:120px;" })
                                        <a href="~/User/Logout" class="btn btn-sm fw-bold text-white" style="background-color:red; border:none; border-radius:5px; color:white; width:100px;">Logout</a>
                                    </div>
                                </li>



                            </ul>
                        </li>

                    </ul>
                </div>
