<!-- Why? Explanation Modal -->
<div class="modal fade" id="whyAchievedModal" tabindex="-1" aria-labelledby="whyAchievedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header  text-white">
                <h5 class="modal-title" id="whyAchievedModalLabel">
                    <i class="fas fa-calculator me-2"></i>How Your Achieved Deposit is Calculated
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="lead text-muted mb-4">
                    Your <strong>Achieved Deposit</strong> reflects the <strong>Real Growth</strong> in each account after accounting for withdrawals — shared fairly among contributors.
                </p>

                @if (ViewBag.AchievedBreakdown != null)
                {
                    var breakdown = ViewBag.AchievedBreakdown as System.Collections.IEnumerable;
                    if (breakdown != null && breakdown.GetEnumerator().MoveNext())
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-hover align-middle text-end">
                                <thead class="table-primary">
                                    <tr>
                                        <th class="text-start">Account Number</th>
                                        <th>True Initial Balance<br><small>(Earliest Prev_Bal)</small></th>
                                        <th>Total Deposits<br><small>(All users)</small></th>
                                        <th>Your Contribution</th>
                                        <th>Current Balance<br><small>(Latest from Temenos)</small></th>
                                        <th>Available Growth</th>
                                        <th>Your Achieved Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        decimal grandTotalAchieved = 0;
                                        foreach (dynamic item in ViewBag.AchievedBreakdown)
                                        {
                                            decimal achieved = item.UserAchieved is decimal ? item.UserAchieved : 0m;
                                            decimal userContribution = item.UserContribution is decimal ? item.UserContribution : 0m;
                                            decimal availableGrowth = item.AvailableFund is decimal ? item.AvailableFund : 0m;
                                            grandTotalAchieved += achieved;

                                            <tr>
                                                <td class="text-start fw-bold text-primary">@(item.AccountNumber?.ToString() ?? "N/A")</td>
                                                <td>@String.Format("{0:N2}", item.InitialBalance is decimal ? item.InitialBalance : 0m)</td>
                                                <td>@String.Format("{0:N2}", item.TotalDeposited is decimal ? item.TotalDeposited : 0m)</td>
                                                <td class="text-success fw-bold">@String.Format("{0:N2}", userContribution)</td>
                                                <td>@String.Format("{0:N2}", item.FinalBalance is decimal ? item.FinalBalance : 0m)</td>
                                                <td class="text-info">@String.Format("{0:N2}", availableGrowth)</td>
                                                <td class="text-success fw-bold fs-5">@String.Format("{0:N2}", achieved)</td>
                                            </tr>
                                        }
                                    }
                                    <tr class="table-success fw-bold fs-5">
                                        <td colspan="6" class="text-end">TOTAL ACHIEVED DEPOSIT →</td>
                                        <td class="text-center">@String.Format("{0:N2}", grandTotalAchieved)</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle me-2"></i>No deposit records found yet.
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle me-2"></i>No deposit records found yet.
                    </div>
                }

                <!-- Simple, clear explanation -->
                <div class="alert alert-light border mt-4">
                    <strong>How Achieved Deposit Is Calculated:</strong><br><br>

                    Calculated <strong>per account</strong> using daily system balances:

                               <ol class="mb-2">
                                   <li><strong>Initial Balance (IB)</strong> = Earliest <code>Previous Balance</code></li>
                                   <li><strong>Current Balance (CB)</strong> = Latest <code>AccountBalance</code></li>
                                   <li><strong>Account Growth (AG)</strong> = max(CB − IB, 0)</li>
                                   <li><strong>Your Share (YS)</strong> = (Your Deposits ÷ Total Deposits) × AG</li>
                                   <li>
                                       <strong>Cap Rule</strong>: YS ≤ Your Actual Deposits
                                       <br>
                                       <small class="text-muted">
                                           <strong>Cap Rule :-</strong>  You cannot earn achievement from money you did not deposit.
                                       </small>
                                   </li>

                               </ol>

                    <strong>Formula:</strong><br>
                    <code>Achieved Deposit = Σ min((Your Deposits ÷ Total Deposits) × (CB − IB), Your Deposits)</code>

                    <hr class="my-3">
                    <small class="text-muted">
                        Only real account growth is shared. Withdrawals reduce credit automatically.
                    </small>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Merchant List Modal - FIXED & SAFE -->
<div class="modal fade" id="merchantListModal" tabindex="-1" aria-labelledby="merchantListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-purple text-white">
                <h5 class="modal-title" id="merchantListModalLabel">
                    Merchants Onboarded by You (@ViewBag.achivedDepositAgenet)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (ViewBag.AchievedBreakdownMerchant != null &&
                     ((IEnumerable<TRMS.Models.MerchantOnboardedViewModel>)ViewBag.AchievedBreakdownMerchant).Any())
                {
                    var merchants = (IEnumerable<TRMS.Models.MerchantOnboardedViewModel>)ViewBag.AchievedBreakdownMerchant;

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Merchant ID</th>
                                    <th>Account Holder</th>
                                    <th>Account Number</th>
                                    <th>Amount Collected</th>
                                    <th>Onboarded On</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int index = 1; }
                                @foreach (var m in merchants)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td class="fw-bold text-primary">@m.LinkAccount</td>
                                        <td>@m.AccountHolder</td>
                                        <td>@m.AccountNumber</td>
                                        <td class="text-success fw-bold">@String.Format("{0:N2}", m.TotalDepositedByUser)</td>
                                        <td>@m.CreatedDate.ToString("dd MMM yyyy")</td>
                                        @{ index++; }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-users fa-3x mb-3 opacity-50"></i>
                        <p>No merchants onboarded yet.</p>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
