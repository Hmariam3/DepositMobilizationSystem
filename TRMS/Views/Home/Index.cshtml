@{
    ViewBag.Title = "Dashboard";

    var achievedPercent = ViewBag.AssinedTargetdeposit != 0 ? (ViewBag.achivedDeposit * 100) / ViewBag.AssinedTargetdeposit : 0;
    var remainingPercent = ViewBag.AssinedTargetdeposit != 0 ? (ViewBag.remaing * 100) / ViewBag.AssinedTargetdeposit : 0;

    var achievedPercentAgenet = ViewBag.AssinedTargetAgent != 0 ? (ViewBag.uniqueMerchantCount * 100) / ViewBag.AssinedTargetAgent : 0;
    var remainingPercentAgenet = ViewBag.AssinedTargetAgent != 0 ? (ViewBag.remaing1 * 100) / ViewBag.AssinedTargetAgent : 0;

    var achievedPercentFcy = ViewBag.AssinedTargetFCY != 0 ? (ViewBag.achivedDepositFCY * 100) / ViewBag.AssinedTargetFCY : 0;
    var remainingPercentFcy = ViewBag.AssinedTargetFCY != 0 ? (ViewBag.remaing2 * 100) / ViewBag.AssinedTargetFCY : 0;
}

<style>
    body {
        font-family: Arial, sans-serif;
    }
        .dashboard-card {
        margin: 5px;
        padding: 10px;
        border-radius: 10px;
        min-height: 100px;
    }

    .dashboard-title {
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .dashboard-card h1 {
        font-size: 20px;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .dashboard-card h1 {
            font-size: 16px;
        }
        .dashboard-title {
            font-size: 12px;
        }
    }
    .dashboard-card {
        width: 300px;
        min-width: 250px;
        height: 200px;
        padding: 10px;
        border-radius: 10px;
        box-shadow: 2px 4px 8px rgba(0, 0, 0, 0.1);
        margin-right: 15px;
    }

    .dashboard-title {
        font-weight: bold;
        font-size: 18px;
        padding-bottom: 5px;
    }

    .dashboard-value {
        font-weight: bold;
        font-size: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    .dashboard-row {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 15px;
        padding-bottom: 10px;
    }

        .dashboard-row::-webkit-scrollbar {
            height: 8px;
        }

        .dashboard-row::-webkit-scrollbar-thumb {
            background-color: #00AEEF;
            border-radius: 4px;
        }

    hr {
        width: 100%;
        height: 2px;
        background-color: #00AEEF;
        border: none;
        margin: 10px auto;
    }

    .alert-danger {
        background-color: #dc3545 !important;
        color: white;
    }

    .section-header {
        text-align: center;
        margin: 40px 0 20px 0;
    }

        .section-header h2 {
            color: #007bff;
            font-weight: bold;
        }

    .panel {
        border-radius: 10px;
        background: #f8f9fa;
        padding: 15px;
        box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="container mt-4">

    <!-- ===================== Deposit Progress ===================== -->
    <div class="section-header">
        <h2>Deposit Progress</h2>
        <hr />
    </div>

    <div class="dashboard-row text-center">
        <div class="card text-white bg-primary dashboard-card">
            <div class="card-header dashboard-title">Assigned Target</div>
            <h1>@ViewBag.AssinedTargetdeposit.ToString("N2")</h1>
        </div>

        <div class="card text-white bg-primary dashboard-card">
            <div class="card-header dashboard-title">Account Balance</div>
            <h1>@ViewBag.acountBlance.ToString("N2")</h1>
            <div class="card-header dashboard-title">Initial Account Balance</div>
            <h1>@ViewBag.AaccountountIntial.ToString("N2")</h1>
        </div>

        <div class="card text-white bg-success dashboard-card">
            <div class="card-header dashboard-title">Deposit Amount</div>
            <h1>@ViewBag.achivedDeposit.ToString("N2")</h1>
            <div class="card-header dashboard-title">Deposit Percentage</div>
            <h1>@(achievedPercent.ToString("F2")) %</h1>
        </div>

        <div class="card text-white bg-success dashboard-card">
            <div class="card-header dashboard-title">Remaining Amount</div>
            <h1>@ViewBag.remaing.ToString("N2")</h1>
            <div class="card-header dashboard-title">Remaining Percentage</div>
            <h1>@(remainingPercent.ToString("F2")) %</h1>
        </div>

        <div class="card text-white bg-success dashboard-card">
            <div class="card-header dashboard-title">Deposit % Relative to Branch</div>
            <h1>@(ViewBag.avargaeUserProgressDeposit.ToString("F2")) %</h1>
        </div>
    </div>

    <div class="row mt-4 text-center">
        <div class="col-md-12">
            <div class="panel">
                <div class="alert @ViewBag.MessageClass" role="alert">
                    <strong>@ViewBag.MessageText</strong><br />
                    <p>Target: @string.Format("{0:N0}", ViewBag.AssinedTargetdeposit) over 90 days</p>
                    <p>Day: @ViewBag.DaysElapsed</p>
                    <p>Expected by now: @ViewBag.Expected.ToString("N2")</p>
                    <p>Collected: @ViewBag.Collected.ToString("N2")</p>
                    <p>Progress: @ViewBag.ProgressPercent.ToString("F3")%</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== Merchant Deposit ===================== -->
    <div class="section-header">
        <h2>Your Deposit From Merchant</h2>
        <hr />
    </div>

    <div class="dashboard-row text-center">
        <div class="card text-white bg-primary dashboard-card">
            <div class="card-header dashboard-title">Assigned Target</div>
            <h1>@ViewBag.AssinedTargetAgent</h1>
        </div>

        <div class="card text-white bg-primary dashboard-card">
            <div class="card-header dashboard-title">Achieved Merchant</div>
            <h1>@ViewBag.uniqueMerchantCount</h1>
            <div class="card-header dashboard-title">Initial Account Balance</div>
            <h1>@ViewBag.AaccountountIntial.ToString("N2")</h1>
        </div>

        <div class="card text-white bg-success dashboard-card">
            <div class="card-header dashboard-title">Collected Amount</div>
            <h1>@ViewBag.achivedDepositAgenet</h1>
            <div class="card-header dashboard-title">Deposit Percentage</div>
            <h1>@(achievedPercentAgenet.ToString("F2")) %</h1>
            
           
        </div>

        <div class="card text-white bg-warning dashboard-card">
            <div class="card-header dashboard-title">Remaining Amount</div>
            <h1>@ViewBag.remaing1</h1>
            <div class="card-header dashboard-title">Remaining Percentage</div>
            <h1>@(remainingPercentAgenet.ToString("F2")) %</h1>
        </div>
        <div class="card text-white bg-success dashboard-card">
            <div class="card-header dashboard-title">Deposit % Relative to Branch</div>
            <h1>@(ViewBag.avargaeUserProgressDeposit.ToString("F2")) %</h1>
        </div>
    </div>

    <div class="row mt-4 text-center">
        <div class="col-md-12">
            <div class="panel">
                <div class="alert @ViewBag.MessageClass1" role="alert">
                    <strong>@ViewBag.MessageText1</strong><br />
                    <p>Target: @ViewBag.AssinedTargetAgent over 90 days</p>
                    <p>Day: @ViewBag.DaysElapsed</p>
                    <p>Expected by now: @ViewBag.ExpectedAgent.ToString("N2")</p>
                    <p>Collected: @ViewBag.CollectedAgent.ToString("N2")</p>
                    <p>Progress: @ViewBag.progressPercentAgent.ToString("F3")%</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== FCY Deposit ===================== -->
    <div class="section-header">
        <h2>Your FCY Deposit</h2>
        <hr />
    </div>

    <div class="dashboard-row text-center">
        <div class="card text-white bg-primary dashboard-card">
            <div class="card-header dashboard-title">Assigned Plan</div>
            <h1>@ViewBag.AssinedTargetFCY</h1>
        </div>

        <div class="card text-white bg-success dashboard-card">
            <div class="card-header dashboard-title">Collected Amount</div>
            <h1>@ViewBag.achivedDepositFCY</h1>
            <div class="card-header dashboard-title">FCY Deposit Percentage</div>
            <h1>@(achievedPercentFcy.ToString("F2")) %</h1>
        </div>

        <div class="card text-white bg-warning dashboard-card">
            <div class="card-header dashboard-title">Remaining Amount</div>
            <h1>@ViewBag.remaing2</h1>
            <div class="card-header dashboard-title">Remaining Percentage</div>
            <h1>@(remainingPercentFcy.ToString("F2")) %</h1>
        </div>
        <div class="card text-white bg-success dashboard-card">
            <div class="card-header dashboard-title">Deposit % Relative to Branch</div>
            <h1>@(ViewBag.avargaeUserProgressFcy.ToString("F2")) %</h1>
        </div>
    </div>

    <div class="row mt-4 text-center">
        <div class="col-md-12">
            <div class="panel">
                <div class="alert @ViewBag.MessageClass2" role="alert">
                    <strong>@ViewBag.MessageText2</strong><br />
                    <p>Target: @ViewBag.AssinedTargetFCY over 90 days</p>
                    <p>Day: @ViewBag.DaysElapsed</p>
                    <p>Expected by now: @ViewBag.expectedFCY.ToString("N2")</p>
                    <p>Collected: @ViewBag.CollectedFCY.ToString("N2")</p>
                    <p>Progress: @ViewBag.progressPercentFCY.ToString("F3")%</p>
                </div>
            </div>
        </div>
    </div>
</div>
