@{
    /**/

    ViewBag.Title = "Dashboard";

    // Handle null values with safe defaults
    var assignedTargetDeposit = ViewBag.AssinedTargetdeposit is decimal ? ViewBag.AssinedTargetdeposit : 0m;
    var achievedDeposit = ViewBag.achivedDeposit is decimal ? ViewBag.achivedDeposit : 0m;
    var remaining = ViewBag.remaing is decimal ? ViewBag.remaing : 0m;
    var depositPlan = ViewBag.depositplan is decimal ? ViewBag.depositplan : 0m;

    var assignedTargetAgent = ViewBag.AssinedTargetAgent is decimal ? ViewBag.AssinedTargetAgent : 0m;
    var uniqueMerchantCount = ViewBag.uniqueMerchantCount is int ? ViewBag.uniqueMerchantCount : 0;
    var remaining1 = ViewBag.remaing1 is decimal ? ViewBag.remaing1 : 0m;
    var accountIntialAgent = ViewBag.AaccountountIntialAgent is decimal ? ViewBag.AaccountountIntialAgent : 0m;
    var achievedDepositAgent = ViewBag.achivedDepositAgenet is decimal ? ViewBag.achivedDepositAgenet : 0m;

    var assignedTargetFCY = ViewBag.AssinedTargetFCY is decimal ? ViewBag.AssinedTargetFCY : 0m;
    var achievedDepositFCY = ViewBag.achivedDepositFCY is decimal ? ViewBag.achivedDepositFCY : 0m;
    var remaining2 = ViewBag.remaing2 is decimal ? ViewBag.remaing2 : 0m;

    // Calculate percentages with safe division
    var achievedPercent = assignedTargetDeposit != 0 ? (achievedDeposit * 100) / assignedTargetDeposit : 0;
    var remainingPercent = assignedTargetDeposit != 0 ? (remaining * 100) / assignedTargetDeposit : 0;
    var achievedPercentAgenet = assignedTargetAgent != 0 ? (uniqueMerchantCount * 100) / assignedTargetAgent : 0;
    var remainingPercentAgenet = assignedTargetAgent != 0 ? (remaining1 * 100) / assignedTargetAgent : 0;
    var achievedPercentFcy = assignedTargetFCY != 0 ? (achievedDepositFCY * 100) / assignedTargetFCY : 0;
    var remainingPercentFcy = assignedTargetFCY != 0 ? (remaining2 * 100) / assignedTargetFCY : 0;

    // Default values for other ViewBag properties
    var accountInitial = ViewBag.AaccountountIntial is decimal ? ViewBag.AaccountountIntial : 0m;
    var accountBalance = ViewBag.acountBlance is decimal ? ViewBag.acountBlance : 0m;
    var withdrawal = ViewBag.withdrawal is decimal ? ViewBag.withdrawal : 0m;
    var progressPercent = ViewBag.ProgressPercent is decimal ? ViewBag.ProgressPercent : 0m;
    var averageUserProgressDeposit = ViewBag.avargaeUserProgressDeposit is decimal ? ViewBag.avargaeUserProgressDeposit : 0m;
    var expected = ViewBag.Expected is decimal ? ViewBag.Expected : 0m;
    var daysElapsed = ViewBag.DaysElapsed is int ? ViewBag.DaysElapsed : 0;
    var collected = ViewBag.Collected is decimal ? ViewBag.Collected : 0m;
    var messageClass = ViewBag.MessageClass as string ?? "alert-info";
    var messageText = ViewBag.MessageText as string ?? "Progress information not available";

    // Merchant/Agent values
    var progressPercentAgent = ViewBag.progressPercentAgent is decimal ? ViewBag.progressPercentAgent : 0m;
    var averageUserProgressMerchant = ViewBag.avargaeUserProgressMerchant is decimal ? ViewBag.avargaeUserProgressMerchant : 0m;
    var expectedAgent = ViewBag.ExpectedAgent is decimal ? ViewBag.ExpectedAgent : 0m;
    var collectedAgent = ViewBag.CollectedAgent is decimal ? ViewBag.CollectedAgent : 0m;
    var messageClass1 = ViewBag.MessageClass1 as string ?? "alert-info";
    var messageText1 = ViewBag.MessageText1 as string ?? "Merchant progress information not available";
    var colorAgent = ViewBag.colorAgent as string ?? "bg-info";

    // FCY values
    var progressPercentFCY = ViewBag.progressPercentFCY is decimal ? ViewBag.progressPercentFCY : 0m;
    var averageUserProgressFcy = ViewBag.avargaeUserProgressFcy is decimal ? ViewBag.avargaeUserProgressFcy : 0m;
    var expectedFCY = ViewBag.expectedFCY is decimal ? ViewBag.expectedFCY : 0m;
    var collectedFCY = ViewBag.CollectedFCY is decimal ? ViewBag.CollectedFCY : 0m;
    var messageClass2 = ViewBag.MessageClass2 as string ?? "alert-info";
    var messageText2 = ViewBag.MessageText2 as string ?? "FCY progress information not available";
    var colorAFCY = ViewBag.colorAFCY as string ?? "bg-info";
    var color = ViewBag.Color as string ?? "bg-info";
}

<style>
