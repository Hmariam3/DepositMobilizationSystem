                        <small class="d-block mt-1 opacity-75">Total Deposit: @String.Format("{0:N2}", depositPlan)</small>
                    </div>
                </div>
            </div>

            <!-- Deposit Achieved -->
            <div class="col-sm-6 col-lg-4 col-xl-3">
