        --primary: #00ADEF;
        --primary-gradient: linear-gradient(135deg, #00AEEF, #0077b6);
        --primary-dark: #0095d1;
        --gray-light: #f8f9fa;
        --text-dark: #1f2937;
        --error: #dc3545;
        --success: #198754;
        --danger: #dc3545;
        --warning: #ffc107;
        --light: #f8f9fa;
        --dark: #212529;
    }

    .modal-header {
        background-color: var(--primary);
    }

    h1, h2, hr {
        color: var(--primary);
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
        letter-spacing: -0.3px;
    }
</style>

