@model IEnumerable<TRMS.Models.DistrictDepositViewModel>
@using Newtonsoft.Json
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

<link href="~/Content/bord.css" rel="stylesheet" />
<style>
    body {
        font-family: 'Arial', sans-serif;
        background-color: #f0f4f8;
        color: #333;
        margin: 0;
        padding: 0;
        height: 100vh;
    }

    .container {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 20px;
    }

    .dashboard-card {
        height: 220px;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease-in-out;
        margin-bottom: 20px;
    }

        .dashboard-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

    .dashboard-title {
        font-weight: bold;
        font-size: 26px;
        padding-bottom: 10px;
        color: #2d3e50;
    }

    .dashboard-value {
        font-weight: bold;
        font-size: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #fff;
    }

    .bg-success {
        background: linear-gradient(145deg, #57c4a8, #45a29e);
    }

    .bg-danger {
        background: linear-gradient(145deg, #f14c4c, #e74c3c);
    }

    .marquee {
        font-size: 38px;
        font-weight: bold;
        color: #fff;
        padding: 10px;
        background-color: #007bff;
        border-radius: 5px;
        overflow: hidden;
        white-space: nowrap;
    }

        .marquee span {
            display: inline-block;
            animation: marquee-animation 10s linear infinite;
        }
</style>

<head>
    <link href="~/Content/print.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <title>Auto Refresh</title>
    <script type="text/javascript">
        setTimeout(function () {
            location.reload();
        }, 10000); // Refresh every 10 seconds
    </script>
</head>

<!-- Chart Section -->
<script src="~/Content/chart.js"></script>
<div class="container" style="width:100%;margin-left:-200px;">
    <div class="row">
        <div class="col-12">
            <div class="card-body text-center">
                <div class="marquee" style="background-color:#00AEEF; height:100px;">
                    <span>Graphical Report</span>
                </div>
            </div>
        </div>
    </div>
        <div class="row mt-4">
            <div class="col-md-12">
                <canvas id="districtDepositChart"></canvas>
            </div>
        </div>
    </div>
    @using Newtonsoft.Json
    @{
        var allDataJson = JsonConvert.SerializeObject(ViewBag.AllData);
    }

    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const allData = @Html.Raw(allDataJson);

        // Get all unique districts
        const districts = [...new Set(allData.map(x => x.District))];

        // For each type, get target and deposit values per district
        const getValues = (type, field) => districts.map(d => {
            const item = allData.find(x => x.District === d && x.Type === type);
            return item ? item[field] : 0;
        });

        const depositTargets = getValues("Deposit", "TotalTarget");
        const depositAchieved = getValues("Deposit", "TotalDeposit");

        const merchantTargets = getValues("Merchant", "TotalTarget");
        const merchantAchieved = getValues("Merchant", "TotalDeposit");

        const fcyTargets = getValues("FCY", "TotalTarget");
        const fcyAchieved = getValues("FCY", "TotalDeposit");

        const ctx = document.getElementById('districtDepositChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: districts,
                datasets: [
                    {
                        label: 'Deposit Target',
                        data: depositTargets,
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        stack: 'Deposit'
                    },
                    {
                        label: 'Deposit Achieved',
                        data: depositAchieved,
                        backgroundColor: 'rgba(54, 162, 235, 1)',
                        stack: 'Deposit'
                    },
                    {
                        label: 'Merchant Target',
                        data: merchantTargets,
                        backgroundColor: 'rgba(255, 206, 86, 0.6)',
                        stack: 'Merchant'
                    },
                    {
                        label: 'Merchant Achieved',
                        data: merchantAchieved,
                        backgroundColor: 'rgba(255, 206, 86, 1)',
                        stack: 'Merchant'
                    },
                    {
                        label: 'FCY Target',
                        data: fcyTargets,
                        backgroundColor: 'rgba(75, 192, 192, 0.6)',
                        stack: 'FCY'
                    },
                    {
                        label: 'FCY Achieved',
                        data: fcyAchieved,
                        backgroundColor: 'rgba(75, 192, 192, 1)',
                        stack: 'FCY'
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Target vs Achieved by District and Type',
                        font: { size: 18 }
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false
                    },
                    legend: {
                        position: 'bottom'
                    }
                },
                scales: {
                    x: {
                        stacked: true
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Amount'
                        }
                    }
                }
            }
        });
    });
    </script>
